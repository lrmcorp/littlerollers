{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "NODE_ENV",
    "PORT",
    "WEB_PORT",
    "API_BASE_URL",
    "PUBLIC_WEB_BASE_URL",
    "DATABASE_URL",
    "REDIS_URL",
    "HEALTH_PROBE_TIMEOUT_MS",
    "WORKER_HEARTBEAT_INTERVAL_MS",
    "WORKER_HEARTBEAT_TTL_SECONDS",
    "QUOTA_EVALUATION_SYNTHETIC_ENABLED",
    "QUOTA_EVALUATION_POLL_INTERVAL_MS",
    "QUOTA_EVALUATION_LEASE_MS",
    "QUOTA_EVALUATION_MAX_ATTEMPTS",
    "QUOTA_EVALUATION_BACKOFF_MS",
    "AUTH_SYNTHETIC_ENABLED",
    "AUTH_PASSWORD_ENABLED",
    "BOOKING_ENABLED",
    "BOOKING_CUTOFF_HOURS",
    "IDENTITY_DOCUMENT_SYNTHETIC_SCAN_RESULT",
    "SYNTHETIC_BOOTSTRAP_SUPER_OWNER_EMAIL",
    "NEXT_PUBLIC_AUTH_SYNTHETIC_ENABLED",
    "EMAIL_DRIVER",
    "EMAIL_DELIVERY_ENABLED",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_SECURE",
    "SMTP_USER",
    "SMTP_PASSWORD",
    "SMTP_FROM_NAME",
    "SMTP_FROM_EMAIL",
    "SMTP_CONNECTION_TIMEOUT_MS",
    "SMTP_MAX_ATTEMPTS",
    "SMTP_RATE_LIMIT_PER_MINUTE",
    "SMTP_RATE_LIMIT_PER_HOUR",
    "NOTIFICATION_ENCRYPTION_KEY",
    "EMAIL_RECIPIENT_OVERRIDE",
    "RESEND_API_KEY"
  ],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", ".next/**", "!.next/cache/**"] },
    "dev": { "cache": false, "persistent": true },
    "lint": { "dependsOn": ["^build"] },
    "typecheck": { "dependsOn": ["^build"] },
    "test": { "dependsOn": ["^build"], "outputs": ["coverage/**"] }
  }
}
