{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "NODE_ENV",
    "PORT",
    "WEB_PORT",
    "API_BASE_URL",
    "PUBLIC_WEB_BASE_URL",
    "DATABASE_URL",
    "REDIS_URL",
    "HEALTH_PROBE_TIMEOUT_MS",
    "WORKER_HEARTBEAT_INTERVAL_MS",
    "WORKER_HEARTBEAT_TTL_SECONDS",
    "QUOTA_EVALUATION_SYNTHETIC_ENABLED",
    "QUOTA_EVALUATION_POLL_INTERVAL_MS",
    "QUOTA_EVALUATION_LEASE_MS",
    "QUOTA_EVALUATION_MAX_ATTEMPTS",
    "QUOTA_EVALUATION_BACKOFF_MS",
    "OBJECT_STORAGE_ENDPOINT",
    "OBJECT_STORAGE_ACCESS_KEY",
    "OBJECT_STORAGE_SECRET_KEY",
    "OBJECT_STORAGE_BUCKET",
    "OBJECT_STORAGE_USE_SSL",
    "AUTH_SYNTHETIC_ENABLED",
    "AUTH_PASSWORD_ENABLED",
    "IDENTITY_DOCUMENT_SYNTHETIC_SCAN_RESULT",
    "SYNTHETIC_BOOTSTRAP_SUPER_OWNER_EMAIL",
    "NEXT_PUBLIC_AUTH_SYNTHETIC_ENABLED"
  ],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", ".next/**", "!.next/cache/**"] },
    "dev": { "cache": false, "persistent": true },
    "lint": { "dependsOn": ["^build"] },
    "typecheck": { "dependsOn": ["^build"] },
    "test": { "dependsOn": ["^build"], "outputs": ["coverage/**"] }
  }
}
