NODE_ENV=production
APP_VERSION=dev
PORT=32121
WEB_PORT=32120
WEB_BIND_ADDRESS=127.0.0.1
API_BASE_URL=http://api:32121
PUBLIC_WEB_BASE_URL=https://dailydosepilates.com

MYSQL_DATABASE=dailydose
MYSQL_USER=dailydose
MYSQL_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_WITH_ANOTHER_LONG_RANDOM_PASSWORD
DATABASE_URL=mysql://dailydose:CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD@mysql:3306/dailydose
REDIS_URL=redis://redis:6379

HEALTH_PROBE_TIMEOUT_MS=2000
WORKER_HEARTBEAT_INTERVAL_MS=10000
WORKER_HEARTBEAT_TTL_SECONDS=30
QUOTA_EVALUATION_SYNTHETIC_ENABLED=false
QUOTA_EVALUATION_POLL_INTERVAL_MS=10000
QUOTA_EVALUATION_LEASE_MS=30000
QUOTA_EVALUATION_MAX_ATTEMPTS=5
QUOTA_EVALUATION_BACKOFF_MS=60000

PRIVATE_UPLOAD_DRIVER=local
PRIVATE_UPLOAD_ROOT=/app/data/private
PRIVATE_UPLOAD_MAX_BYTES=8000000
PRIVATE_VIEW_AUTH_TTL_SECONDS=300
IDENTITY_DOCUMENT_RETENTION_DAYS=30

AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=2592000
AUTH_OTP_TTL_SECONDS=300
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_INVITATION_TTL_SECONDS=86400
AUTH_PASSWORD_ENABLED=true
AUTH_SYNTHETIC_ENABLED=false
NEXT_PUBLIC_AUTH_SYNTHETIC_ENABLED=false
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Transactional email. Generate NOTIFICATION_ENCRYPTION_KEY with:
# openssl rand -base64 32
EMAIL_DRIVER=smtp
EMAIL_DELIVERY_ENABLED=true
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@dailydosepilates.com
SMTP_PASSWORD=CHANGE_ME_WITH_NIAGAHOSTER_MAILBOX_PASSWORD
SMTP_FROM_NAME=Daily Dose Pilates
SMTP_FROM_EMAIL=noreply@dailydosepilates.com
SMTP_CONNECTION_TIMEOUT_MS=15000
SMTP_MAX_ATTEMPTS=5
SMTP_RATE_LIMIT_PER_MINUTE=3
SMTP_RATE_LIMIT_PER_HOUR=150
NOTIFICATION_ENCRYPTION_KEY=CHANGE_ME_WITH_BASE64_32_BYTE_KEY
# Manual rollback driver only; SMTP failures never fail over automatically.
RESEND_API_KEY=
# Non-production only. Production rejects recipient overrides.
EMAIL_RECIPIENT_OVERRIDE=
PUBLIC_SUPPORT_WHATSAPP_E164=+628111000000

PAYMENT_PROOF_MAX_BYTES=10000000
PAYMENT_PROOF_SCAN_DRIVER=clamav
PAYMENT_PROOF_CLAMAV_HOST=clamav
PAYMENT_PROOF_CLAMAV_PORT=3310
PAYMENT_PROOF_SCAN_TIMEOUT_MS=15000
PAYMENT_PROOF_ABANDONED_TTL_MINUTES=60
PURCHASE_IDEMPOTENCY_TTL_SECONDS=86400

BOOKING_ENABLED=false
BOOKING_CUTOFF_HOURS=2
RESCHEDULE_ENABLED=false
RESCHEDULE_CUTOFF_HOURS=24
BOOKING_CANCELLATION_ENABLED=false
BOOKING_CANCELLATION_CUTOFF_HOURS=24
SESSION_ADJUSTMENT_ENABLED=false
RBAC_POLICY_SOURCE=shadow
RBAC_MANAGEMENT_ENABLED=false
IDENTITY_REVIEW_ENABLED=false
