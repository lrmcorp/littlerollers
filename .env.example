NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://dailydose:dailydose_local@localhost:55432/dailydose?schema=public
REDIS_URL=redis://localhost:6379
HEALTH_PROBE_TIMEOUT_MS=2000
WORKER_HEARTBEAT_INTERVAL_MS=10000
WORKER_HEARTBEAT_TTL_SECONDS=30
QUOTA_EVALUATION_SYNTHETIC_ENABLED=true
QUOTA_EVALUATION_POLL_INTERVAL_MS=10000
QUOTA_EVALUATION_LEASE_MS=30000
QUOTA_EVALUATION_MAX_ATTEMPTS=5
QUOTA_EVALUATION_BACKOFF_MS=60000
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=dailydose_local
OBJECT_STORAGE_SECRET_KEY=dailydose_local_only
OBJECT_STORAGE_BUCKET=dailydose-private
OBJECT_STORAGE_USE_SSL=false
# Production-required provider, pricing, quota, fee, TTL, and policy values intentionally have no defaults.
AUTH_ACCESS_TTL_SECONDS=
AUTH_REFRESH_TTL_SECONDS=
AUTH_OTP_TTL_SECONDS=
AUTH_OTP_MAX_ATTEMPTS=

# Synthetic adapters are test/local-only and rejected in production.
AUTH_SYNTHETIC_ENABLED=false
SYNTHETIC_BOOTSTRAP_SUPER_OWNER_EMAIL=
AUTH_SYNTHETIC_OTP_CODE=
AUTH_SYNTHETIC_MFA_PROOF=
AUTH_SYNTHETIC_RECOVERY_PROOF=
NEXT_PUBLIC_AUTH_SYNTHETIC_ENABLED=false

# Synthetic payment-proof fixtures; explicit values are required when enabled.
PAYMENT_PROOF_SYNTHETIC_ENABLED=false
PAYMENT_PROOF_SYNTHETIC_MAX_BYTES=
PAYMENT_PROOF_TTL_SECONDS=
PAYMENT_PROOF_SYNTHETIC_SCAN_RESULT=
PURCHASE_IDEMPOTENCY_TTL_SECONDS=

# Synthetic booking policy. Production remains fail-closed without an approved policy.
BOOKING_SYNTHETIC_ENABLED=false
BOOKING_SYNTHETIC_CUTOFF_HOURS=2
