NODE_ENV=development
PORT=32121
WEB_PORT=32120
API_BASE_URL=http://127.0.0.1:32121
DATABASE_URL=mysql://dailydose:dailydose_local@127.0.0.1:3306/dailydose_local
REDIS_URL=redis://localhost:6379
HEALTH_PROBE_TIMEOUT_MS=2000
WORKER_HEARTBEAT_INTERVAL_MS=10000
WORKER_HEARTBEAT_TTL_SECONDS=30
QUOTA_EVALUATION_SYNTHETIC_ENABLED=true
QUOTA_EVALUATION_POLL_INTERVAL_MS=10000
QUOTA_EVALUATION_LEASE_MS=30000
QUOTA_EVALUATION_MAX_ATTEMPTS=5
QUOTA_EVALUATION_BACKOFF_MS=60000
# Private customer identity documents. Local persistent storage is the v1 driver.
PRIVATE_UPLOAD_DRIVER=local
PRIVATE_UPLOAD_ROOT=apps/api/.local-data/private
PRIVATE_UPLOAD_MAX_BYTES=8000000
PRIVATE_VIEW_AUTH_TTL_SECONDS=300
IDENTITY_DOCUMENT_RETENTION_DAYS=30
# Production-required provider, pricing, quota, fee, TTL, and policy values intentionally have no defaults.
AUTH_ACCESS_TTL_SECONDS=
AUTH_REFRESH_TTL_SECONDS=
AUTH_OTP_TTL_SECONDS=
AUTH_OTP_MAX_ATTEMPTS=
AUTH_INVITATION_TTL_SECONDS=

# Password sign-in, transaction email, and Google Identity Services.
AUTH_PASSWORD_ENABLED=false
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
RESEND_API_KEY=
AUTH_EMAIL_FROM=
PUBLIC_WEB_BASE_URL=http://127.0.0.1:32120
PUBLIC_SUPPORT_WHATSAPP_E164=+628111000000

# Synthetic adapters are test/local-only and rejected in production.
AUTH_SYNTHETIC_ENABLED=false
SYNTHETIC_BOOTSTRAP_SUPER_OWNER_EMAIL=
AUTH_SYNTHETIC_OTP_CODE=
AUTH_SYNTHETIC_RECOVERY_PROOF=
NEXT_PUBLIC_AUTH_SYNTHETIC_ENABLED=false

# Payment-proof scanner. Use synthetic only for development/test; production requires clamav.
PAYMENT_PROOF_SYNTHETIC_SCAN_RESULT=CLEAN
PAYMENT_PROOF_MAX_BYTES=10000000
PAYMENT_PROOF_SCAN_DRIVER=synthetic
PAYMENT_PROOF_CLAMAV_HOST=
PAYMENT_PROOF_CLAMAV_PORT=3310
PAYMENT_PROOF_SCAN_TIMEOUT_MS=15000
PAYMENT_PROOF_ABANDONED_TTL_MINUTES=60
PURCHASE_IDEMPOTENCY_TTL_SECONDS=

# Synthetic booking policy. Production remains fail-closed without an approved policy.
BOOKING_SYNTHETIC_ENABLED=false
BOOKING_SYNTHETIC_CUTOFF_HOURS=2
RESCHEDULE_SYNTHETIC_ENABLED=true
RESCHEDULE_SYNTHETIC_CUTOFF_HOURS=24
