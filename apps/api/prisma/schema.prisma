  paymentProof                          PaymentProof?                 @relation(fields: [paymentProofId], references: [id], onDelete: Restrict)
  paymentAccount                        PaymentAccount?               @relation(fields: [paymentAccountId], references: [id], onDelete: Restrict)
  continuationClassSlot                 ClassSlot?                    @relation("PurchaseContinuationSlot", fields: [continuationClassSlotId], references: [id], onDelete: Restrict)
  decidedBy                             User?                         @relation("PurchaseDecisionActor", fields: [decidedById], references: [id], onDelete: Restrict)
  customerPackage                       CustomerPackage?
