  @@index([branchId, active])
}

model Purchase {
  id                                    String                        @id @db.Char(36)
  userId                                String                        @db.Char(36)
  branchId                              String                        @db.Char(36)
  packageId                             String                        @db.Char(36)
  voucherId                             String?                       @db.Char(36)
  packagePromotionId                    String?                       @db.Char(36)
  packagePromotionNameSnapshot          String?                       @db.VarChar(160)
  packagePromotionDiscountTypeSnapshot  VoucherDiscountType?
  packagePromotionDiscountValueSnapshot Int?
  packagePromotionDiscountRpSnapshot    Int?
  promotionalPriceRpSnapshot            Int?
  voucherCodeSnapshot                   String?                       @db.VarChar(64)
  voucherDiscountTypeSnapshot           VoucherDiscountType?
  voucherDiscountValueSnapshot          Int?
  voucherDiscountRpSnapshot             Int?
  priceAfterDiscountRpSnapshot          Int?
  paymentProofId                        String?                       @unique @db.Char(36)
  paymentAccountId                      String?                       @db.Char(36)
  paymentBankNameSnapshot               String?
  paymentAccountNumberSnapshotEncrypted String?                       @db.Text
  paymentAccountLast4Snapshot           String?                       @db.VarChar(4)
  paymentAccountHolderSnapshot          String?
  paymentExpiresAt                      DateTime?
  continuationClassSlotId               String?                       @db.Char(36)
  packageNameSnapshot                   String
  priceRpSnapshot                       Int
  paymentUniqueCode                     Int?
  payableAmountRpSnapshot               Int?
  sessionCountSnapshot                  Int
  durationDaysSnapshot                  Int
  status                                PurchaseStatus                @default(PENDING)
  idempotencyKeyHash                    String
  submittedAt                           DateTime                      @default(now())
  decidedAt                             DateTime?
  decidedById                           String?                       @db.Char(36)
  decisionReasonCode                    String?
  timelineComplete                      Boolean                       @default(false)
  version                               Int                           @default(0)
  user                                  User                          @relation(fields: [userId], references: [id], onDelete: Restrict)
  branch                                Branch                        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  package                               Package                       @relation(fields: [packageId], references: [id], onDelete: Restrict)
  voucher                               Voucher?                      @relation(fields: [voucherId], references: [id], onDelete: Restrict)
