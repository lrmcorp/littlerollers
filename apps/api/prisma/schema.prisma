generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum IdentityProvider {
  GOOGLE
  WHATSAPP_PHONE
}

enum AssignmentType {
  OWNER
  INSTRUCTOR
}

enum ApplicationRole {
  CUSTOMER
  INSTRUCTOR
  ADMIN
  MANAGER
  OWNER
  SUPER_OWNER
  FINANCE
  OPS
}

enum SessionChannel {
  WEB
  MOBILE
}

enum AssuranceLevel {
  BASE
  MFA
}

enum ChallengeKind {
  OTP
  MFA
  RECOVERY
}

enum ChallengeStatus {
  PENDING
  VERIFIED
  EXPIRED
  LOCKED
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

model User {
  id String @id @db.Uuid
  displayName String
  status UserStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  identities Identity[]
  assignments Assignment[]
  roles UserRole[]
  sessions UserSession[]
  challenges AuthChallenge[]
}
model Identity {
  id String @id @db.Uuid
  userId String @db.Uuid
  provider IdentityProvider
  subjectHash String
  verifiedAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@unique([provider, subjectHash])
  @@index([userId])
}
model Branch {
  id String @id @db.Uuid
  code String @unique
  name String
  timezone String
  active Boolean @default(true)
  createdAt DateTime @default(now())
  assignments Assignment[]
  userRoles UserRole[]
  configurations EffectiveConfiguration[]
}
model Assignment {
  id String @id @db.Uuid
  userId String @db.Uuid
  branchId String @db.Uuid
  type AssignmentType
  activeFrom DateTime @db.Date
  activeUntil DateTime? @db.Date
  version Int @default(0)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  @@index([userId, activeFrom, activeUntil])
  @@index([branchId, type, activeFrom, activeUntil])
}

model UserRole {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  role ApplicationRole
  branchId String? @db.Uuid
  activeFrom DateTime
  activeUntil DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)
  @@index([userId, activeFrom, activeUntil])
  @@index([branchId, role, activeFrom, activeUntil])
}

model UserSession {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  channel SessionChannel
  tokenFamilyHash String
  accessTokenHash String @unique
  refreshTokenHash String? @unique
  assurance AssuranceLevel @default(BASE)
  expiresAt DateTime
  refreshExpiresAt DateTime?
  revokedAt DateTime?
  revocationReason String?
  createdAt DateTime @default(now())
  rotatedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([userId, expiresAt, revokedAt])
  @@index([tokenFamilyHash, revokedAt])
}

model AuthChallenge {
  id String @id @default(uuid()) @db.Uuid
  userId String? @db.Uuid
  kind ChallengeKind
  purpose String
  subjectHash String
  proofHash String
  status ChallengeStatus @default(PENDING)
  attempts Int @default(0)
  maxAttempts Int
  expiresAt DateTime
  verifiedAt DateTime?
  createdAt DateTime @default(now())
  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([kind, subjectHash, createdAt])
  @@index([status, expiresAt])
}
model AuditLog {
  id String @id @db.Uuid
  occurredAt DateTime @default(now())
  actorType String
  actorId String? @db.Uuid
  branchId String? @db.Uuid
  action String
  objectType String
  objectId String
  beforeMasked Json?
  afterMasked Json?
  correlationId String
  @@index([branchId, occurredAt])
  @@index([objectType, objectId, occurredAt])
}
model IdempotencyRecord {
  id String @id @db.Uuid
  scope String
  keyHash String
  requestHash String
  status IdempotencyStatus @default(IN_PROGRESS)
  responseStatus Int?
  responseBody Json?
  responseHeaders Json?
  createdAt DateTime @default(now())
  completedAt DateTime?
  leaseExpiresAt DateTime
  expiresAt DateTime
  @@unique([scope, keyHash])
  @@index([expiresAt])
  @@index([status, leaseExpiresAt])
}
model OutboxEvent {
  id String @id @db.Uuid
  eventType String
  aggregateType String
  aggregateId String
  payload Json
  correlationId String
  status OutboxStatus @default(PENDING)
  occurredAt DateTime @default(now())
  publishedAt DateTime?
  attempts Int @default(0)
  @@index([status, occurredAt])
  @@index([aggregateType, aggregateId])
}
model EffectiveConfiguration {
  id String @id @db.Uuid
  kind String
  businessKey String
  branchId String? @db.Uuid
  value Json
  effectiveFrom DateTime
  effectiveUntil DateTime?
  approvedEvidence String?
  createdAt DateTime @default(now())
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)
  @@index([kind, businessKey, effectiveFrom, effectiveUntil])
  @@index([branchId, kind, effectiveFrom])
}
