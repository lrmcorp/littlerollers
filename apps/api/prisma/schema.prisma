datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================================
// ENUMS
// ============================================================================

enum Role {
  SUPER_OWNER
  OWNER
  MANAGER
  FINANCE
  ADMIN
  INSTRUCTOR
  CUSTOMER
  SUPERADMIN
  COACH
  MEMBER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SessionMutationType {
  PURCHASE
  ATTEND
  REFUND_AUTOCANCEL
  ADJUST_MANUAL
}

enum AdjustRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CloseStatus {
  OPEN
  LOCKED
}

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ClassModality {
  GROUP
  PRIVATE
  DUET
  SEMI_PRIVATE
}

enum PackageStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum PurchaseStatus {
  PENDING
  WAITING_VERIFICATION
  PAID
  CANCELLED
  REJECTED
}

enum CustomerPackageStatus {
  ACTIVE
  DEPLETED
  EXPIRED
  FROZEN
}

enum ClassSlotStatus {
  DRAFT
  PUBLISHED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  BOOKED
  ATTENDED
  CANCELLED
  NO_SHOW
}

enum PaymentMethod {
  BANK_TRANSFER
  QRIS
  CASH
  CARD
  MANUAL_STAFF
}

enum RescheduleStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum CheckInMethod {
  QR_SCAN
  MANUAL_FRONTDESK
  WEB_LINK
}

// ============================================================================
// PILAR 1: FASILITAS & MULTI-CABANG
// ============================================================================

model Cabang {
  id                  String   @id @default(uuid()) @db.Char(36)
  code                String   @unique @db.VarChar(32)
  name                String   @db.VarChar(128)
  address             String?  @db.Text
  supportWhatsappE164 String?  @map("phone") @db.VarChar(32)
  timezone            String   @default("Asia/Jakarta") @db.VarChar(64)
  heroImageKey        String?  @map("hero_image_key") @db.VarChar(255)
  galleryImageKeys    Json?    @map("gallery_image_keys")
  active              Boolean  @default(true) @map("isActive")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  studios               Studio[]
  classSlots            SlotKelas[]
  instructorAssignments PenugasanInstruktur[]
  purchases             Pembelian[]
  paymentAccounts       RekeningPembayaran[]
  ownerAssignments      OwnerCabang[]
  minQuotaSettings      MinQuotaSetting[]
  instructorFees        InstructorFee[]
  projectionRates       ProjectionRate[]
  otherCosts            OtherCost[]
  monthlyCloses         MonthlyClose[]
  correctionJournals    CorrectionJournal[]
  instructorAvailabilities InstructorAvailability[]
  packages              Paket[]

  @@map("cabang")
}

model Studio {
  id                  String   @id @default(uuid()) @db.Char(36)
  branchId            String   @db.Char(36)
  code                String   @db.VarChar(32)
  name                String   @db.VarChar(128)
  description         String?  @db.Text
  imageKey            String?  @map("image_key") @db.VarChar(255)
  active              Boolean  @default(true) @map("isActive")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  branch     Cabang      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  rooms      Ruangan[]
  classSlots SlotKelas[]

  @@unique([branchId, code])
  @@index([branchId, active])
  @@map("studio")
}

model Ruangan {
  id          String   @id @default(uuid()) @db.Char(36)
  studioId    String   @db.Char(36)
  code        String   @db.VarChar(32)
  name        String   @db.VarChar(128)
  capacityBed Int      @default(1)
  active      Boolean  @default(true) @map("isActive")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  studio     Studio      @relation(fields: [studioId], references: [id], onDelete: Restrict)
  classSlots SlotKelas[]

  @@unique([studioId, code])
  @@index([studioId, active])
  @@map("ruangan")
}

model JenisKelas {
  id              String        @id @default(uuid()) @db.Char(36)
  code            String        @unique @db.VarChar(32)
  name            String        @db.VarChar(128)
  modality        ClassModality @default(GROUP)
  description     String?       @db.Text
  durationMinutes Int           @default(50)
  defaultCapacity Int           @default(8)
  heroImageKey    String?       @map("hero_image_key") @db.VarChar(255)
  galleryImageKeys Json?        @map("gallery_image_keys")
  active          Boolean       @default(true) @map("isActive")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  packages         Paket[]
  classSlots       SlotKelas[]
  minQuotaSettings MinQuotaSetting[]
  instructorFees   InstructorFee[]
  projectionRates  ProjectionRate[]

  @@map("jenis_kelas")
}

// ============================================================================
// PILAR 2: PENGGUNA & PERAN
// ============================================================================

model User {
  id                String     @id @default(uuid()) @db.Char(36)
  email             String?    @unique @db.VarChar(191)
  phone             String?    @unique @db.VarChar(32)
  displayName       String     @map("name") @db.VarChar(128)
  passwordHash      String?    @db.VarChar(255)
  role              Role       @default(MEMBER)
  status            UserStatus @default(ACTIVE)
  rememberToken     String?    @map("remember_token") @db.VarChar(100)
  preferredBranchId String?    @db.Char(36)
  stoppedAt         DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  profile               ProfilPengguna?
  sessions              UserSession[]
  instructorAssignments PenugasanInstruktur[]
  instructedClassSlots  SlotKelas[]           @relation("InstructorSlot")
  purchases             Pembelian[]
  customerPackages      PaketPelanggan[]
  bookings              PemesananKelas[]
  verifiedPurchases     Pembelian[]           @relation("PurchaseVerifier")
  recordedAttendances   KehadiranPelanggan[]  @relation("AttendanceRecorder")
  ownedBranches         OwnerCabang[]
  instructorFees        InstructorFee[]
  createdSessionLedgers SessionLedger[]       @relation("LedgerCreator")
  createdOtherCosts     OtherCost[]           @relation("OtherCostCreator")
  closedMonths          MonthlyClose[]        @relation("MonthlyCloseUser")
  requestedCorrections  CorrectionJournal[]   @relation("CorrectionRequester")
  approvedCorrections   CorrectionJournal[]   @relation("CorrectionApprover")
  requestedAdjustments  SessionAdjustRequest[] @relation("AdjustRequester")
  approvedAdjustments   SessionAdjustRequest[] @relation("AdjustApprover")
  instructorAvailabilities InstructorAvailability[]

  @@index([role, status])
  @@map("user")
}

model UserSession {
  id               String    @id @default(uuid()) @db.Char(36)
  userId           String    @db.Char(36)
  channel          String    @default("WEB") @db.VarChar(16)
  tokenFamilyHash  String    @db.VarChar(64)
  accessTokenHash  String    @unique @db.VarChar(64)
  refreshTokenHash String    @unique @db.VarChar(64)
  expiresAt        DateTime
  refreshExpiresAt DateTime
  revokedAt        DateTime?
  revocationReason String?   @db.VarChar(64)
  rotatedAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_session")
}

model ProfilPengguna {
  id                    String    @id @default(uuid()) @db.Char(36)
  userId                String    @unique @db.Char(36)
  fullName              String?   @db.VarChar(128)
  gender                String?   @db.VarChar(16)
  birthDate             DateTime? @db.Date
  avatarUrl             String?   @db.Text
  ktpUrl                String?   @map("ktp_url") @db.Text
  selfieUrl             String?   @map("selfie_url") @db.Text
  nik                   String?   @db.VarChar(32)
  address               String?   @db.Text
  emergencyContactName  String?   @db.VarChar(128)
  emergencyContactPhone String?   @db.VarChar(32)
  notes                 String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profil_pengguna")
}

model PenugasanInstruktur {
  id        String   @id @default(uuid()) @db.Char(36)
  coachId   String   @db.Char(36)
  branchId  String   @db.Char(36)
  active    Boolean  @default(true) @map("isActive")
  createdAt DateTime @default(now())

  coach  User   @relation(fields: [coachId], references: [id], onDelete: Restrict)
  branch Cabang @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([coachId, branchId])
  @@index([branchId, active])
  @@map("penugasan_instruktur")
}

// ============================================================================
// PILAR 3: PAKET SESI & PENJUALAN (BILLING)
// ============================================================================

model Paket {
  id           String        @id @default(uuid()) @db.Char(36)
  branchId     String?       @db.Char(36)
  classTypeId  String?       @db.Char(36)
  code         String        @unique @db.VarChar(32)
  name         String        @db.VarChar(128)
  sessionCount Int
  validityDays Int
  priceRp      Int
  description  String?       @db.Text
  status       PackageStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  branch           Cabang?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  classType        JenisKelas?      @relation(fields: [classTypeId], references: [id], onDelete: Restrict)
  purchases        Pembelian[]
  customerPackages PaketPelanggan[]

  @@index([status, classTypeId])
  @@index([branchId])
  @@map("paket")
}

model Pembelian {
  id               String         @id @default(uuid()) @db.Char(36)
  invoiceNumber    String         @unique @db.VarChar(64)
  userId           String         @db.Char(36)
  branchId         String         @db.Char(36)
  packageId        String         @db.Char(36)
  voucherId        String?        @db.Char(36)
  subtotalRp       Int
  discountRp       Int            @default(0)
  totalAmountRp    Int
  status           PurchaseStatus @default(PENDING)
  paymentMethod    PaymentMethod  @default(BANK_TRANSFER)
  paymentExpiresAt DateTime?
  paidAt           DateTime?
  verifiedById     String?        @db.Char(36)
  verifiedAt       DateTime?
  rejectionReason  String?        @db.Text
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  branch          Cabang           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  package         Paket            @relation(fields: [packageId], references: [id], onDelete: Restrict)
  voucher         Voucher?         @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  verifiedBy      User?            @relation("PurchaseVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  paymentProof    BuktiPembayaran?
  customerPackage PaketPelanggan?

  @@index([userId, status])
  @@index([branchId, status, createdAt])
  @@map("pembelian")
}

model BuktiPembayaran {
  id            String   @id @default(uuid()) @db.Char(36)
  purchaseId    String   @unique @db.Char(36)
  fileUrl       String   @db.Text
  bankName      String?  @db.VarChar(64)
  accountHolder String?  @db.VarChar(128)
  notes         String?  @db.Text
  uploadedAt    DateTime @default(now())

  purchase Pembelian @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@map("bukti_pembayaran")
}

model PaketPelanggan {
  id                String                @id @default(uuid()) @db.Char(36)
  purchaseId        String?               @unique @db.Char(36)
  userId            String                @db.Char(36)
  packageId         String                @db.Char(36)
  totalSessions     Int
  remainingSessions Int
  usedSessions      Int                   @default(0)
  validFrom         DateTime              @default(now())
  validUntil        DateTime
  status            CustomerPackageStatus @default(ACTIVE)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  purchase       Pembelian?             @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  user           User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  package        Paket                  @relation(fields: [packageId], references: [id], onDelete: Restrict)
  bookings       PemesananKelas[]
  ledgers        SessionLedger[]
  adjustRequests SessionAdjustRequest[]

  @@index([userId, status, validUntil])
  @@map("paket_pelanggan")
}

model RekeningPembayaran {
  id            String   @id @default(uuid()) @db.Char(36)
  branchId      String?  @db.Char(36)
  bankName      String   @db.VarChar(64)
  accountNumber String   @db.VarChar(64)
  accountHolder String   @db.VarChar(128)
  active        Boolean  @default(true) @map("isActive")
  createdAt     DateTime @default(now())

  branch Cabang? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@map("rekening_pembayaran")
}

model Voucher {
  id            String    @id @default(uuid()) @db.Char(36)
  code          String    @unique @db.VarChar(32)
  name          String    @db.VarChar(128)
  discountType  String    @default("NOMINAL")
  discountValue Int
  imageKey      String?   @map("image_key") @db.VarChar(255)
  description   String?   @db.Text
  minSpendRp    Int       @default(0)
  maxDiscountRp Int?
  quota         Int       @default(100)
  usedCount     Int       @default(0)
  validUntil    DateTime?
  active        Boolean   @default(true) @map("isActive")
  createdAt     DateTime  @default(now())

  purchases Pembelian[]

  @@map("voucher")
}

// ============================================================================
// PILAR 4: JADWAL & PEMESANAN KELAS (BOOKINGS)
// ============================================================================

model SlotKelas {
  id                 String          @id @default(uuid()) @db.Char(36)
  branchId           String          @db.Char(36)
  studioId           String          @db.Char(36)
  roomId             String?         @db.Char(36)
  classTypeId        String          @db.Char(36)
  instructorId       String?         @db.Char(36)
  startAt            DateTime
  endAt              DateTime
  capacity           Int
  bookedCount        Int             @default(0)
  minQuota           Int?
  status             ClassSlotStatus @default(PUBLISHED)
  notes              String?         @db.Text
  cancellationReason String?         @db.Text
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  branch                Cabang           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  studio                Studio           @relation(fields: [studioId], references: [id], onDelete: Restrict)
  room                  Ruangan?         @relation(fields: [roomId], references: [id], onDelete: SetNull)
  classType             JenisKelas       @relation(fields: [classTypeId], references: [id], onDelete: Restrict)
  instructor            User?            @relation("InstructorSlot", fields: [instructorId], references: [id], onDelete: SetNull)
  bookings              PemesananKelas[]
  rescheduleSourceSlots UbahJadwal[]     @relation("SourceSlot")
  rescheduleTargetSlots UbahJadwal[]     @relation("TargetSlot")

  @@index([branchId, startAt, status])
  @@index([instructorId, startAt])
  @@map("slot_kelas")
}

model PemesananKelas {
  id                 String        @id @default(uuid()) @db.Char(36)
  bookingNumber      String        @unique @db.VarChar(64)
  classSlotId        String        @db.Char(36)
  userId             String        @db.Char(36)
  customerPackageId  String        @db.Char(36)
  status             BookingStatus @default(BOOKED)
  bookedAt           DateTime      @default(now())
  cancelledAt        DateTime?
  cancellationReason String?       @db.Text
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  classSlot       SlotKelas              @relation(fields: [classSlotId], references: [id], onDelete: Restrict)
  user            User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  customerPackage PaketPelanggan         @relation(fields: [customerPackageId], references: [id], onDelete: Restrict)
  attendance      KehadiranPelanggan?
  checkInTokens   CheckInToken[]
  reschedules     UbahJadwal[]
  adjustRequests  SessionAdjustRequest[]

  @@index([userId, status])
  @@index([classSlotId, status])
  @@map("pemesanan_kelas")
}

model UbahJadwal {
  id            String           @id @default(uuid()) @db.Char(36)
  bookingId     String           @db.Char(36)
  sourceSlotId  String           @db.Char(36)
  targetSlotId  String           @db.Char(36)
  requestedById String           @db.Char(36)
  status        RescheduleStatus @default(APPROVED)
  reason        String?          @db.Text
  requestedAt   DateTime         @default(now())

  booking    PemesananKelas @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sourceSlot SlotKelas      @relation("SourceSlot", fields: [sourceSlotId], references: [id], onDelete: Restrict)
  targetSlot SlotKelas      @relation("TargetSlot", fields: [targetSlotId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@map("ubah_jadwal")
}

// ============================================================================
// PILAR 5: PRESENSI & OPERASIONAL HARIAN
// ============================================================================

model KehadiranPelanggan {
  id           String        @id @default(uuid()) @db.Char(36)
  bookingId    String        @unique @db.Char(36)
  method       CheckInMethod @default(QR_SCAN)
  checkedInAt  DateTime      @default(now())
  recordedById String?       @db.Char(36)
  notes        String?       @db.Text

  booking    PemesananKelas @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  recordedBy User?          @relation("AttendanceRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([checkedInAt])
  @@map("kehadiran_pelanggan")
}

model CheckInToken {
  id        String   @id @default(uuid()) @db.Char(36)
  bookingId String   @db.Char(36)
  token     String   @unique @db.VarChar(128)
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  booking PemesananKelas @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, expiresAt, isUsed])
  @@map("check_in_token")
}

model PasswordActionToken {
  id           String    @id @default(uuid()) @db.Char(36)
  kind         String    @db.VarChar(32)
  tokenHash    String    @unique @db.VarChar(191)
  emailHash    String    @db.VarChar(191)
  userId       String?   @db.Char(36)
  invitationId String?   @db.Char(36)
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([emailHash])
  @@index([userId])
  @@map("password_action_token")
}

// ============================================================================
// PILAR 6: SPESIFIKASI V1.0 (MUTASI LEDGER, OTORISASI & MODUL KEUANGAN)
// ============================================================================

model SessionLedger {
  id                String              @id @default(uuid()) @db.Char(36)
  customerPackageId String              @db.Char(36)
  type              SessionMutationType
  amount            Int
  balanceAfter      Int
  referenceId       String?             @db.VarChar(64)
  notes             String?             @db.Text
  createdById       String?             @db.Char(36)
  createdAt         DateTime            @default(now())

  customerPackage   PaketPelanggan      @relation(fields: [customerPackageId], references: [id], onDelete: Cascade)
  createdBy         User?               @relation("LedgerCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([customerPackageId, createdAt])
  @@map("session_ledger")
}

model OwnerCabang {
  id        String   @id @default(uuid()) @db.Char(36)
  ownerId   String   @db.Char(36)
  branchId  String   @db.Char(36)
  createdAt DateTime @default(now())

  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  branch    Cabang   @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([ownerId, branchId])
  @@index([branchId])
  @@map("owner_cabang")
}

model MinQuotaSetting {
  id          String   @id @default(uuid()) @db.Char(36)
  branchId    String   @db.Char(36)
  classTypeId String   @db.Char(36)
  minQuota    Int      @default(1)
  cutoffHours Int      @default(24)
  active      Boolean  @default(true) @map("isActive")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch    Cabang     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  classType JenisKelas @relation(fields: [classTypeId], references: [id], onDelete: Restrict)

  @@unique([branchId, classTypeId])
  @@map("min_quota_setting")
}

model InstructorFee {
  id            String   @id @default(uuid()) @db.Char(36)
  instructorId  String   @db.Char(36)
  branchId      String   @db.Char(36)
  classTypeId   String   @db.Char(36)
  feePerJamRp   Int
  effectiveDate DateTime @db.Date
  createdAt     DateTime @default(now())

  instructor User       @relation(fields: [instructorId], references: [id], onDelete: Restrict)
  branch     Cabang     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  classType  JenisKelas @relation(fields: [classTypeId], references: [id], onDelete: Restrict)

  @@index([instructorId, branchId, classTypeId, effectiveDate])
  @@map("instructor_fee")
}

model ProjectionRate {
  id            String   @id @default(uuid()) @db.Char(36)
  branchId      String   @db.Char(36)
  classTypeId   String   @db.Char(36)
  ratePerSesiRp Int
  effectiveDate DateTime @db.Date
  createdAt     DateTime @default(now())

  branch    Cabang     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  classType JenisKelas @relation(fields: [classTypeId], references: [id], onDelete: Restrict)

  @@index([branchId, classTypeId, effectiveDate])
  @@map("projection_rate")
}

model OtherCost {
  id          String   @id @default(uuid()) @db.Char(36)
  branchId    String   @db.Char(36)
  period      String   @db.VarChar(7)
  category    String   @default("OTHER") @db.VarChar(64)
  description String   @db.Text
  amountRp    Int
  createdById String?  @db.Char(36)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch    Cabang @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy User?  @relation("OtherCostCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([branchId, period])
  @@map("other_cost")
}

model MonthlyClose {
  id               String      @id @default(uuid()) @db.Char(36)
  branchId         String      @db.Char(36)
  period           String      @db.VarChar(7)
  omsetRp          Int         @default(0)
  costProjectionRp Int         @default(0)
  costRealtimeRp   Int         @default(0)
  otherCostRp      Int         @default(0)
  profitRp         Int         @default(0)
  status           CloseStatus @default(OPEN)
  controlHash      String?     @db.VarChar(128)
  closedById       String?     @db.Char(36)
  closedAt         DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  branch   Cabang @relation(fields: [branchId], references: [id], onDelete: Restrict)
  closedBy User?  @relation("MonthlyCloseUser", fields: [closedById], references: [id], onDelete: SetNull)

  @@unique([branchId, period])
  @@map("monthly_close")
}

model CorrectionJournal {
  id            String           @id @default(uuid()) @db.Char(36)
  branchId      String           @db.Char(36)
  period        String           @db.VarChar(7)
  targetPeriod  String           @db.VarChar(7)
  amountRp      Int
  reason        String           @db.Text
  status        CorrectionStatus @default(PENDING)
  requestedById String           @db.Char(36)
  approvedById  String?          @db.Char(36)
  approvedAt    DateTime?
  // Alasan keputusan (kontrak `ReasonCommand`) dan penjaga konkurensi optimistis.
  decisionReason String?         @db.Text
  version       Int              @default(1)
  createdAt     DateTime         @default(now())

  branch      Cabang @relation(fields: [branchId], references: [id], onDelete: Restrict)
  requestedBy User   @relation("CorrectionRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy  User?  @relation("CorrectionApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([branchId, period])
  @@map("correction_journal")
}

model SessionAdjustRequest {
  id                String              @id @default(uuid()) @db.Char(36)
  customerPackageId String              @db.Char(36)
  bookingId         String?             @db.Char(36)
  reason            String              @db.Text
  sessionCount      Int                 @default(1)
  status            AdjustRequestStatus @default(PENDING)
  requestedById     String              @db.Char(36)
  approvedById      String?             @db.Char(36)
  decisionReason    String?             @db.Text
  // Kode terkontrol untuk kontrak /session-adjustments; `reason`/`decisionReason` tetap teks bebas.
  reasonCode        String?             @db.VarChar(40)
  decisionCode      String?             @db.VarChar(40)
  decisionNote      String?             @db.Text
  // Penjaga konkurensi optimistis: dinaikkan tiap keputusan, dicocokkan dengan expectedVersion.
  version           Int                 @default(1)
  createdAt         DateTime            @default(now())
  decidedAt         DateTime?

  customerPackage PaketPelanggan  @relation(fields: [customerPackageId], references: [id], onDelete: Cascade)
  booking         PemesananKelas? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  requestedBy     User            @relation("AdjustRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy      User?           @relation("AdjustApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([customerPackageId, status])
  @@map("session_adjust_request")
}

model InstructorAvailability {
  id           String   @id @default(uuid()) @db.Char(36)
  instructorId String   @db.Char(36)
  branchId     String   @db.Char(36)
  date         DateTime @db.Date
  startTime    String   @db.VarChar(8)
  endTime      String   @db.VarChar(8)
  createdAt    DateTime @default(now())

  instructor User   @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  branch     Cabang @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([instructorId, date])
  @@map("instructor_availability")
}

model ReminderLog {
  id             String   @id @default(uuid()) @db.Char(36)
  recipientPhone String   @db.VarChar(32)
  recipientType  String   @db.VarChar(16)
  reminderType   String   @db.VarChar(64)
  payload        Json?
  status         String   @default("SENT") @db.VarChar(16)
  sentAt         DateTime @default(now())

  @@index([recipientPhone, reminderType, sentAt])
  @@map("reminder_log")
}

model LaravelMigration {
  id        Int    @id @default(autoincrement()) @db.UnsignedInt
  migration String @db.VarChar(255)
  batch     Int

  @@map("migrations")
}
