model User {
  id                                 String                              @id @db.Char(36)
  displayName                        String
  email                              String?                             @unique
  phoneE164                          String?                             @unique
  preferredBranchId                  String?                             @db.Char(36)
  status                             UserStatus                          @default(ACTIVE)
  version                            Int                                 @default(0)
  createdAt                          DateTime                            @default(now())
  updatedAt                          DateTime                            @updatedAt
  identities                         Identity[]
  assignments                        Assignment[]
  roles                              UserRole[]
  sessions                           UserSession[]
  challenges                         AuthChallenge[]
  passwordCredential                 PasswordCredential?
  passwordActions                    PasswordActionToken[]
  createdInvitations                 UserInvitation[]                    @relation("InvitationCreator")
  activationInvitation               UserInvitation?                     @relation("InvitationTarget")
  paymentProofs                      PaymentProof[]
  purchases                          Purchase[]
  voucherRedemptions                 VoucherRedemption[]
  createdVouchers                    Voucher[]                           @relation("VoucherCreator")
  createdPackagePromotions           PackagePromotion[]                  @relation("PackagePromotionCreator")
  decidedPurchases                   Purchase[]                          @relation("PurchaseDecisionActor")
  customerPackages                   CustomerPackage[]
  requestedAdjustments               SessionAdjustment[]                 @relation("AdjustmentRequester")
  decidedAdjustments                 SessionAdjustment[]                 @relation("AdjustmentDecider")
  instructorAvailabilities           InstructorAvailability[]
  instructedClassSlots               ClassSlot[]                         @relation("ClassSlotInstructor")
  customerBookings                   Booking[]                           @relation("BookingCustomer")
  createdBookings                    Booking[]                           @relation("BookingActor")
  cancelledBookings                  Booking[]                           @relation("BookingCanceller")
  requestedReschedules               Reschedule[]                        @relation("RescheduleRequester")
  decidedReschedules                 Reschedule[]                        @relation("RescheduleDecider")
  issuedCheckInTokens                CheckInToken[]                      @relation("CheckInTokenIssuer")
  recordedAttendances                CustomerAttendance[]                @relation("AttendanceRecorder")
  instructorCheckInTokens            InstructorCheckInToken[]            @relation("InstructorTokenOwner")
  issuedInstructorCheckInTokens      InstructorCheckInToken[]            @relation("InstructorTokenIssuer")
  instructorAttendances              InstructorAttendance[]              @relation("InstructorAttendanceOwner")
  instructorHourLogs                 InstructorHourLog[]                 @relation("InstructorHourLogOwner")
  identityDocuments                  IdentityVerificationDocument[]      @relation("IdentityDocumentOwner")
  reviewedIdentityDocuments          IdentityVerificationDocument[]      @relation("IdentityDocumentReviewer")
  deletedIdentityDocuments           IdentityVerificationDocument[]      @relation("IdentityDocumentDeleter")
  identityDocumentViewAuthorizations IdentityDocumentViewAuthorization[] @relation("IdentityDocumentViewer")
  paymentProofViewAuthorizations     PaymentProofViewAuthorization[]     @relation("PaymentProofViewer")
  requestedIdentityDocumentDeletions IdentityDocumentDeletionJob[]       @relation("IdentityDocumentDeletionRequester")
  preferredBranch                    Branch?                             @relation("PreferredBranchCustomers", fields: [preferredBranchId], references: [id], onDelete: SetNull)
  notifications                      UserNotification[]
  notificationOccurrences            NotificationOccurrence[]
  accessRoleAssignments              AccessRoleAssignment[]
  capabilityOverrides                UserCapabilityOverride[]            @relation("CapabilityOverrideTarget")
  createdCapabilityOverrides         UserCapabilityOverride[]            @relation("CapabilityOverrideCreator")
  revokedCapabilityOverrides         UserCapabilityOverride[]            @relation("CapabilityOverrideRevoker")
  profile                            UserProfile?
  recurringSchedules                 CustomerRecurringSchedule[]
  bookingFeedbacks                   BookingFeedback[]
  authoredJournalEntries             JournalEntry[]                      @relation("JournalEntryActor")
  authoredLegacyFinancialEntries     LegacyFinancialEntry[]              @relation("LegacyFinancialEntryActor")
  createdOtherCosts                  OtherCost[]                         @relation("OtherCostCreator")
  closedFinancePeriods               FinancePeriod[]                     @relation("FinancePeriodCloser")
  requestedFinanceCorrections        FinanceCorrection[]                 @relation("FinanceCorrectionRequester")
  decidedFinanceCorrections          FinanceCorrection[]                 @relation("FinanceCorrectionDecider")
  mediaAssets                        MediaAsset[]
  contactAliases                     UserContactAlias[]
  customerClassEnrollments           CustomerClassEnrollment[]
  customerVoucherEntitlements        CustomerVoucherEntitlement[]
  historical                         Boolean                             @default(false)
  sourceDeletedAt                    DateTime?
  createdNotificationTemplates       NotificationTemplate[]              @relation("NotificationTemplateCreator")
  createdPublicContents              PublicContentEntry[]                @relation("PublicContentCreator")
  customerSupportCases               SupportCase[]                       @relation("SupportCaseCustomer")
  assignedSupportCases               SupportCase[]                       @relation("SupportCaseAssignee")
  supportNotes                       SupportCaseNote[]                   @relation("SupportNoteAuthor")

  @@index([preferredBranchId])
}

model IdentityVerificationDocument {
  id                    String                              @id @db.Char(36)
  userId                String                              @db.Char(36)
  kind                  IdentityDocumentKind
  status                IdentityVerificationStatus          @default(PENDING)
  objectKey             String?                             @unique
  checksum              String
  fileName              String
  mimeType              String
  sizeBytes             Int
  uploadStatus          PaymentProofUploadStatus            @default(ISSUED)
  scanStatus            PaymentProofScanStatus              @default(PENDING)
  providerReferenceHash String?
  issuedAt              DateTime                            @default(now())
  uploadedAt            DateTime?
  finalizedAt           DateTime?
  reviewedAt            DateTime?
  reviewedById          String?                             @db.Char(36)
  rejectionReasonCode   String?
  rejectionNote         String?                             @db.Text
  replacedById          String?                             @db.Char(36)
  deletedAt             DateTime?
  deletedById           String?                             @db.Char(36)
  deletionReason        String?                             @db.Text
  version               Int                                 @default(0)
  createdAt             DateTime                            @default(now())
  updatedAt             DateTime                            @updatedAt
  user                  User                                @relation("IdentityDocumentOwner", fields: [userId], references: [id], onDelete: Restrict)
  reviewedBy            User?                               @relation("IdentityDocumentReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  deletedBy             User?                               @relation("IdentityDocumentDeleter", fields: [deletedById], references: [id], onDelete: Restrict)
  replacedBy            IdentityVerificationDocument?       @relation("IdentityDocumentReplacement", fields: [replacedById], references: [id], onDelete: Restrict)
  replaces              IdentityVerificationDocument[]      @relation("IdentityDocumentReplacement")
  viewAuthorizations    IdentityDocumentViewAuthorization[]
  deletionJob           IdentityDocumentDeletionJob?

  @@index([userId, kind, createdAt])
  @@index([status, kind, createdAt])
}

model IdentityDocumentViewAuthorization {
  id         String                       @id @db.Char(36)
  documentId String                       @db.Char(36)
  viewerId   String                       @db.Char(36)
  purpose    IdentityDocumentViewPurpose  @default(REVIEW)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime                     @default(now())
  document   IdentityVerificationDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  viewer     User                         @relation("IdentityDocumentViewer", fields: [viewerId], references: [id], onDelete: Restrict)

  @@index([viewerId, expiresAt])
  @@index([documentId, expiresAt])
}

model IdentityDocumentDeletionJob {
  id            String                         @id @db.Char(36)
  documentId    String                         @unique @db.Char(36)
  requestedById String                         @db.Char(36)
  objectKey     String
  status        IdentityDocumentDeletionStatus @default(QUEUED)
  attempts      Int                            @default(0)
  lastErrorCode String?
  nextAttemptAt DateTime?
  completedAt   DateTime?
  createdAt     DateTime                       @default(now())
  updatedAt     DateTime                       @updatedAt
  document      IdentityVerificationDocument   @relation(fields: [documentId], references: [id], onDelete: Restrict)
  requestedBy   User                           @relation("IdentityDocumentDeletionRequester", fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt])
}

model Identity {
  id          String           @id @db.Char(36)
  userId      String           @db.Char(36)
  provider    IdentityProvider
  subjectHash String
  verifiedAt  DateTime?
  createdAt   DateTime         @default(now())
  user        User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, subjectHash])
  @@index([userId])
}

model Branch {
  id                       String                         @id @db.Char(36)
  code                     String                         @unique
  name                     String
  timezone                 String
  supportWhatsappE164      String?
  active                   Boolean                        @default(true)
  version                  Int                            @default(0)
  createdAt                DateTime                       @default(now())
  updatedAt                DateTime                       @updatedAt
  assignments              Assignment[]
  userRoles                UserRole[]
  configurations           EffectiveConfiguration[]
  classTypes               ClassType[]
  classTypeScopes          ClassTypeBranchScope[]
  classTypeConfigurations  ClassTypeBranchConfiguration[]
  packages                 Package[]
  packageScopes            PackageBranchScope[]
  paymentAccounts          PaymentAccount[]
  customerPackages         CustomerPackage[]
  paymentProofs            PaymentProof[]
  purchases                Purchase[]
  vouchers                 Voucher[]
  instructorAvailabilities InstructorAvailability[]
  classSlots               ClassSlot[]
  instructorHourLogs       InstructorHourLog[]
  bookings                 Booking[]
  reschedules              Reschedule[]
  customerAttendances      CustomerAttendance[]
  instructorAttendances    InstructorAttendance[]
  financeCloseSnapshots    FinanceCloseSnapshot[]
  preferredByUsers         User[]                         @relation("PreferredBranchCustomers")
  userNotifications        UserNotification[]
  publicProfile            BranchPublicProfile?
  accessRoleAssignments    AccessRoleAssignment[]
  capabilityOverrides      UserCapabilityOverride[]
  studios                  Studio[]
  openingHours             BranchOpeningHour[]
  recurringSchedules       CustomerRecurringSchedule[]
  accountingAccounts       AccountingAccount[]
  journalEntries           JournalEntry[]
  legacyFinancialEntries   LegacyFinancialEntry[]
  otherCosts               OtherCost[]
  financePeriods           FinancePeriod[]
  financeCorrections       FinanceCorrection[]
  mediaAssets              MediaAsset[]
  migrationCutover         MigrationBranchCutover?
  migrationDeltaEvents     MigrationDeltaEvent[]
  pilotRollbackOutbox      MigrationPilotOutbox[]
  pilotMediaAliases        MigrationPilotMediaAlias[]
  publicContents           PublicContentEntry[]
  supportCases             SupportCase[]
  historical               Boolean                        @default(false)
  sourceDeletedAt          DateTime?
}

model BranchPublicProfile {
  branchId           String   @id @db.Char(36)
  slug               String   @unique
  area               String
  city               String
  address            String
  operationalEmail   String?
  mapUrl             String?  @db.VarChar(1024)
  latitude           Float?
  longitude          Float?
  openingHours       Json
  description        String   @db.Text
  arrivalInformation String?  @db.Text
  parkingInformation String?  @db.Text
  amenities          Json
  heroImageKey       String
  galleryImageKeys   Json
  version            Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  branch             Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([city, area])
}

model PublicClassProfile {
  code            String   @id
  slug            String   @unique
  summary         String
  description     String   @db.Text
  level           String
  durationMinutes Int
  equipment       Json
  benefits        Json
  heroImageKey    String
  active          Boolean  @default(true)
  version         Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ClassType {
  id                       String                         @id @db.Char(36)
  branchId                 String?                        @db.Char(36)
  code                     String                         @unique
  name                     String
  description              String?                        @db.Text
  modality                 ClassModality                  @default(UNKNOWN_LEGACY)
  equipment                Json?
  defaultDurationMinutes   Int                            @default(60)
  defaultMinimumQuota      Int                            @default(1)
  defaultCapacity          Int                            @default(1)
  active                   Boolean                        @default(true)
  version                  Int                            @default(0)
  createdAt                DateTime                       @default(now())
  updatedAt                DateTime                       @updatedAt
  branch                   Branch?                        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  branchScopes             ClassTypeBranchScope[]
  branchConfigurations     ClassTypeBranchConfiguration[]
  configurations           EffectiveConfiguration[]
  packages                 Package[]
  purchases                Purchase[]
  packageScopes            PackageClassTypeScope[]
  voucherScopes            Voucher[]
  customerPackages         CustomerPackage[]
  classSlots               ClassSlot[]
  instructorHourLogs       InstructorHourLog[]
  recurringSchedules       CustomerRecurringSchedule[]
  customerClassEnrollments CustomerClassEnrollment[]
  historical               Boolean                        @default(false)
  sourceDeletedAt          DateTime?
  sourceMetadata           Json?

  @@index([branchId, active])
}

model ClassTypeBranchScope {
  id              String    @id @default(uuid()) @db.Char(36)
  classTypeId     String    @db.Char(36)
  branchId        String    @db.Char(36)
  active          Boolean   @default(true)
  historical      Boolean   @default(false)
  sourceDeletedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  classType       ClassType @relation(fields: [classTypeId], references: [id], onDelete: Restrict)
  branch          Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([classTypeId, branchId])
  @@index([branchId, active])
}

model ClassTypeBranchConfiguration {
  id              String    @id @default(uuid()) @db.Char(36)
  classTypeId     String    @db.Char(36)
  branchId        String    @db.Char(36)
  minimumQuota    Int?
  capacity        Int?
  honorRp         Int?
  feeRp           Int?
  effectiveFrom   DateTime  @db.Date
  effectiveUntil  DateTime? @db.Date
  historical      Boolean   @default(false)
  sourceDeletedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  classType       ClassType @relation(fields: [classTypeId], references: [id], onDelete: Restrict)
  branch          Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([classTypeId, branchId, effectiveFrom], map: "CTBranchConfig_type_branch_from_key")
  @@index([branchId, effectiveFrom, effectiveUntil], map: "CTBranchConfig_branch_from_until_idx")
}

model CustomerClassEnrollment {
  id              String    @id @default(uuid()) @db.Char(36)
  customerUserId  String    @db.Char(36)
  classTypeId     String    @db.Char(36)
  statusCode      String    @db.VarChar(64)
  paidAt          DateTime?
  sessionCount    Int       @default(0)
  historical      Boolean   @default(false)
  sourceDeletedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  customer        User      @relation(fields: [customerUserId], references: [id], onDelete: Restrict)
  classType       ClassType @relation(fields: [classTypeId], references: [id], onDelete: Restrict)

  @@index([customerUserId, statusCode])
  @@index([classTypeId, statusCode])
}

model Assignment {
  id                       String                   @id @db.Char(36)
  userId                   String                   @db.Char(36)
  branchId                 String                   @db.Char(36)
  type                     AssignmentType
  activeFrom               DateTime                 @db.Date
  activeUntil              DateTime?                @db.Date
  version                  Int                      @default(0)
  user                     User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  branch                   Branch                   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  projectedRole            UserRole?                @relation("AssignmentRoleProjection")
  instructorAvailabilities InstructorAvailability[]

  @@index([userId, activeFrom, activeUntil])
  @@index([branchId, type, activeFrom, activeUntil])
}

model InstructorAvailability {
  id                 String     @id @db.Char(36)
  instructorUserId   String     @db.Char(36)
  branchId           String     @db.Char(36)
  sourceAssignmentId String     @db.Char(36)
  startAt            DateTime
  endAt              DateTime
  timezone           String
  version            Int        @default(0)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  instructor         User       @relation(fields: [instructorUserId], references: [id], onDelete: Restrict)
  branch             Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  sourceAssignment   Assignment @relation(fields: [sourceAssignmentId], references: [id], onDelete: Restrict)

  @@index([instructorUserId, startAt, id])
  @@index([branchId, startAt, endAt])
}

model ClassSlot {
  id                      String                           @id @db.Char(36)
  branchId                String                           @db.Char(36)
  classTypeId             String                           @db.Char(36)
  studioId                String                           @db.Char(36)
  roomId                  String?                          @db.Char(36)
  instructorUserId        String?                          @db.Char(36)
  startAt                 DateTime
  endAt                   DateTime
  timezone                String
  minimumQuota            Int
  capacity                Int
  bookedCount             Int                              @default(0)
  status                  ClassSlotStatus                  @default(DRAFT)
  cancellationReasonCode  ClassSlotCancellationReasonCode?
  version                 Int                              @default(0)
  createdAt               DateTime                         @default(now())
  updatedAt               DateTime                         @updatedAt
  branch                  Branch                           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  classType               ClassType                        @relation(fields: [classTypeId], references: [id], onDelete: Restrict)
  studio                  Studio                           @relation(fields: [studioId], references: [id], onDelete: Restrict)
  room                    Room?                            @relation(fields: [roomId], references: [id], onDelete: Restrict)
  instructor              User?                            @relation("ClassSlotInstructor", fields: [instructorUserId], references: [id], onDelete: Restrict)
  reservations            SessionReservation[]
  bookings                Booking[]
  customerAttendances     CustomerAttendance[]
  instructorCheckInTokens InstructorCheckInToken[]
  instructorAttendances   InstructorAttendance[]
  instructorHourLog       InstructorHourLog?
  continuationPurchases   Purchase[]                       @relation("PurchaseContinuationSlot")
  sourceReschedules       Reschedule[]                     @relation("RescheduleSourceSlot")
