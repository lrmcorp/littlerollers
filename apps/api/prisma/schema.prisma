  timelineEvents                        PurchaseTimelineEvent[]
  voucherRedemption                     VoucherRedemption?

  @@unique([userId, idempotencyKeyHash])
  @@index([userId, submittedAt])
  @@index([branchId, status])
  @@index([paymentAccountId, status, paymentExpiresAt])
  @@index([packagePromotionId, submittedAt])
}

model PackagePromotion {
  id            String                 @id @db.Char(36)
  packageId     String                 @db.Char(36)
