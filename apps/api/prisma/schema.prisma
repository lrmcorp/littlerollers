generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING_ACTIVATION
  ACTIVE
  INACTIVE
}

enum IdentityProvider {
  GOOGLE
  WHATSAPP_PHONE
  EMAIL_PASSWORD
}

enum PasswordActionKind {
  ACTIVATION
  RESET
  SETUP
}

enum AssignmentType {
  OWNER
  INSTRUCTOR
}

enum ApplicationRole {
  CUSTOMER
  INSTRUCTOR
  ADMIN
  MANAGER
  OWNER
  SUPER_OWNER
  FINANCE
  OPS
}

enum AccessRoleScope {
  GLOBAL
  BRANCH
}

enum CapabilityOverrideEffect {
  GRANT
  DENY
}

enum SessionChannel {
  WEB
  MOBILE
}

enum ChallengeKind {
  OTP
  RECOVERY
}

enum ChallengeStatus {
  PENDING
  VERIFIED
  EXPIRED
  LOCKED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum NotificationCategory {
  VERIFICATION
  PAYMENT
  PACKAGE
  BOOKING
  RESCHEDULE
  CLASS
  ATTENDANCE
  ADJUSTMENT
  OPERATIONS
  APPROVAL
  SYSTEM
}

enum NotificationTone {
  SUCCESS
  INFO
  WARNING
  DANGER
}

enum NotificationProjectionStatus {
  SUCCEEDED
  SKIPPED
  FAILED
}

enum NotificationChannel {
  EMAIL
}

enum NotificationDeliveryStatus {
  PENDING
  SENDING
  ACCEPTED_BY_SMTP
  FAILED_RETRYABLE
  FAILED_TERMINAL
  EXPIRED
  FALLBACK_IN_APP
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum PackageStatus {
  ACTIVE
  INACTIVE
}

enum VoucherStatus {
  DRAFT
  ACTIVE
  PAUSED
  EXPIRED
  EXHAUSTED
  ARCHIVED
}

enum VoucherDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PackagePromotionStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum PaymentProofUploadStatus {
  ISSUED
  UPLOADED
  FINALIZED
  FAILED
}

enum PaymentProofScanStatus {
  PENDING
  CLEAN
  REJECTED
  INFECTED
  ERROR
}

enum IdentityDocumentKind {
  SELFIE
  KTP_FRONT
}

enum IdentityVerificationStatus {
  PENDING
  APPROVED
  REJECTED
  PENDING_DELETION
  DELETE_FAILED
  DELETED
}

enum IdentityDocumentDeletionStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum IdentityDocumentViewPurpose {
  SELF_VIEW
  REVIEW
}

enum PurchaseStatus {
  AWAITING_PAYMENT
  PENDING
  ACTION_REQUIRED
  APPROVED
  REJECTED
  EXPIRED
}

enum PurchaseTimelineEventType {
  ORDER_CREATED
  PAYMENT_DEADLINE_SET
  PROOF_SUBMITTED
  PROOF_SCAN_COMPLETED
  ACTION_REQUIRED
  PAYMENT_APPROVED
  PAYMENT_REJECTED
  ORDER_EXPIRED
  PACKAGE_ACTIVATED
}

enum LedgerEntryType {
  PURCHASE
  MIGRATION_OPENING
  ATTEND
  REVERSAL
  ADJUST_MANUAL
}

enum CustomerPackageStatus {
  ACTIVE
  INACTIVE
}

enum SessionReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

enum SessionAdjustmentStatus {
  PENDING
  POSTED
  REJECTED
}

enum SessionAdjustmentReasonCode {
  MIGRATION_CORRECTION
  ATTENDANCE_CORRECTION
  PACKAGE_COMPENSATION
  SUPPORT_RECONCILIATION
}

enum SessionAdjustmentDecisionCode {
  CORRECTION_VERIFIED
  INVALID_EVIDENCE
  DUPLICATE_REQUEST
  OUT_OF_SCOPE
}

enum ClassSlotStatus {
  DRAFT
  PUBLISHED
  CONFIRMED
  AUTO_CANCELLED
  CANCELLED
  COMPLETED
}

enum ClassSlotCancellationReasonCode {
  STUDIO_UNAVAILABLE
  INSTRUCTOR_UNAVAILABLE
  SAFETY_ISSUE
  OTHER_REVIEW_REQUIRED
}

enum QuotaEvaluationJobStatus {
  QUEUED
  RUNNING
  RETRYING
  SUCCEEDED
  FAILED
}

enum BookingStatus {
  BOOKED
  RESCHEDULE_PENDING
  CANCELLED
  ATTENDED
  NO_SHOW
}

enum BookingSource {
  SELF
  ADMIN_ASSISTED
}

enum BookingCancellationReasonCode {
  PERSONAL_UNAVAILABLE
  CUSTOMER_SCHEDULE_CONFLICT
  WRONG_CLASS_SELECTED
  OTHER
}

enum CheckInTokenStatus {
  ACTIVE
  USED
  REVOKED
}

enum AttendanceSource {
  QR
}

enum RescheduleStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RescheduleRequestReasonCode {
  CUSTOMER_SCHEDULE_CONFLICT
  WRONG_CLASS_SELECTED
  PERSONAL_UNAVAILABLE
}

enum RescheduleDecisionReasonCode {
  ELIGIBILITY_VERIFIED
  TARGET_UNAVAILABLE
  OUTSIDE_POLICY
  OUT_OF_SCOPE
}

model User {
  id                                 String                              @id @db.Char(36)
  displayName                        String
  email                              String?                             @unique
  phoneE164                          String?                             @unique
  preferredBranchId                  String?                             @db.Char(36)
  status                             UserStatus                          @default(ACTIVE)
  version                            Int                                 @default(0)
  createdAt                          DateTime                            @default(now())
  updatedAt                          DateTime                            @updatedAt
  identities                         Identity[]
  assignments                        Assignment[]
  roles                              UserRole[]
  sessions                           UserSession[]
  challenges                         AuthChallenge[]
  passwordCredential                 PasswordCredential?
  passwordActions                    PasswordActionToken[]
  createdInvitations                 UserInvitation[]                    @relation("InvitationCreator")
  activationInvitation               UserInvitation?                     @relation("InvitationTarget")
  paymentProofs                      PaymentProof[]
  purchases                          Purchase[]
  voucherRedemptions                 VoucherRedemption[]
  createdVouchers                    Voucher[]                           @relation("VoucherCreator")
  createdPackagePromotions           PackagePromotion[]                  @relation("PackagePromotionCreator")
  decidedPurchases                   Purchase[]                          @relation("PurchaseDecisionActor")
  customerPackages                   CustomerPackage[]
  requestedAdjustments               SessionAdjustment[]                 @relation("AdjustmentRequester")
  decidedAdjustments                 SessionAdjustment[]                 @relation("AdjustmentDecider")
  instructorAvailabilities           InstructorAvailability[]
  instructedClassSlots               ClassSlot[]                         @relation("ClassSlotInstructor")
  customerBookings                   Booking[]                           @relation("BookingCustomer")
  createdBookings                    Booking[]                           @relation("BookingActor")
  cancelledBookings                  Booking[]                           @relation("BookingCanceller")
  requestedReschedules               Reschedule[]                        @relation("RescheduleRequester")
  decidedReschedules                 Reschedule[]                        @relation("RescheduleDecider")
  issuedCheckInTokens                CheckInToken[]                      @relation("CheckInTokenIssuer")
  recordedAttendances                CustomerAttendance[]                @relation("AttendanceRecorder")
  identityDocuments                  IdentityVerificationDocument[]      @relation("IdentityDocumentOwner")
  reviewedIdentityDocuments          IdentityVerificationDocument[]      @relation("IdentityDocumentReviewer")
  deletedIdentityDocuments           IdentityVerificationDocument[]      @relation("IdentityDocumentDeleter")
  identityDocumentViewAuthorizations IdentityDocumentViewAuthorization[] @relation("IdentityDocumentViewer")
  paymentProofViewAuthorizations     PaymentProofViewAuthorization[]     @relation("PaymentProofViewer")
  requestedIdentityDocumentDeletions IdentityDocumentDeletionJob[]       @relation("IdentityDocumentDeletionRequester")
  preferredBranch                    Branch?                             @relation("PreferredBranchCustomers", fields: [preferredBranchId], references: [id], onDelete: SetNull)
  notifications                      UserNotification[]
  notificationOccurrences            NotificationOccurrence[]
  accessRoleAssignments              AccessRoleAssignment[]
  capabilityOverrides                UserCapabilityOverride[]            @relation("CapabilityOverrideTarget")
  createdCapabilityOverrides         UserCapabilityOverride[]            @relation("CapabilityOverrideCreator")
  revokedCapabilityOverrides         UserCapabilityOverride[]            @relation("CapabilityOverrideRevoker")

  @@index([preferredBranchId])
}

model IdentityVerificationDocument {
  id                    String                              @id @db.Char(36)
  userId                String                              @db.Char(36)
  kind                  IdentityDocumentKind
  status                IdentityVerificationStatus          @default(PENDING)
  objectKey             String?                             @unique
  checksum              String
  fileName              String
  mimeType              String
  sizeBytes             Int
  uploadStatus          PaymentProofUploadStatus            @default(ISSUED)
  scanStatus            PaymentProofScanStatus              @default(PENDING)
  providerReferenceHash String?
  issuedAt              DateTime                            @default(now())
  uploadedAt            DateTime?
  finalizedAt           DateTime?
  reviewedAt            DateTime?
  reviewedById          String?                             @db.Char(36)
  rejectionReasonCode   String?
  rejectionNote         String?
  replacedById          String?                             @db.Char(36)
  deletedAt             DateTime?
  deletedById           String?                             @db.Char(36)
  deletionReason        String?
  version               Int                                 @default(0)
  createdAt             DateTime                            @default(now())
  updatedAt             DateTime                            @updatedAt
  user                  User                                @relation("IdentityDocumentOwner", fields: [userId], references: [id], onDelete: Restrict)
  reviewedBy            User?                               @relation("IdentityDocumentReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  deletedBy             User?                               @relation("IdentityDocumentDeleter", fields: [deletedById], references: [id], onDelete: Restrict)
  replacedBy            IdentityVerificationDocument?       @relation("IdentityDocumentReplacement", fields: [replacedById], references: [id], onDelete: Restrict)
  replaces              IdentityVerificationDocument[]      @relation("IdentityDocumentReplacement")
  viewAuthorizations    IdentityDocumentViewAuthorization[]
  deletionJob           IdentityDocumentDeletionJob?

  @@index([userId, kind, createdAt])
  @@index([status, kind, createdAt])
}

model IdentityDocumentViewAuthorization {
  id         String                       @id @db.Char(36)
  documentId String                       @db.Char(36)
  viewerId   String                       @db.Char(36)
  purpose    IdentityDocumentViewPurpose  @default(REVIEW)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime                     @default(now())
  document   IdentityVerificationDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  viewer     User                         @relation("IdentityDocumentViewer", fields: [viewerId], references: [id], onDelete: Restrict)

  @@index([viewerId, expiresAt])
  @@index([documentId, expiresAt])
}

model IdentityDocumentDeletionJob {
  id            String                         @id @db.Char(36)
  documentId    String                         @unique @db.Char(36)
  requestedById String                         @db.Char(36)
  objectKey     String
  status        IdentityDocumentDeletionStatus @default(QUEUED)
  attempts      Int                            @default(0)
  lastErrorCode String?
  nextAttemptAt DateTime?
  completedAt   DateTime?
  createdAt     DateTime                       @default(now())
  updatedAt     DateTime                       @updatedAt
  document      IdentityVerificationDocument   @relation(fields: [documentId], references: [id], onDelete: Restrict)
  requestedBy   User                           @relation("IdentityDocumentDeletionRequester", fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt])
}

model Identity {
  id          String           @id @db.Char(36)
  userId      String           @db.Char(36)
  provider    IdentityProvider
  subjectHash String
  verifiedAt  DateTime
  createdAt   DateTime         @default(now())
  user        User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, subjectHash])
  @@index([userId])
}

model Branch {
  id                       String                   @id @db.Char(36)
  code                     String                   @unique
  name                     String
  timezone                 String
  supportWhatsappE164      String?
  active                   Boolean                  @default(true)
  version                  Int                      @default(0)
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  assignments              Assignment[]
  userRoles                UserRole[]
  configurations           EffectiveConfiguration[]
  classTypes               ClassType[]
  packages                 Package[]
  paymentAccounts          PaymentAccount[]
  customerPackages         CustomerPackage[]
  paymentProofs            PaymentProof[]
  purchases                Purchase[]
  vouchers                 Voucher[]
  instructorAvailabilities InstructorAvailability[]
  classSlots               ClassSlot[]
  bookings                 Booking[]
  reschedules              Reschedule[]
  customerAttendances      CustomerAttendance[]
  preferredByUsers         User[]                   @relation("PreferredBranchCustomers")
  userNotifications        UserNotification[]
  publicProfile            BranchPublicProfile?
  accessRoleAssignments    AccessRoleAssignment[]
  capabilityOverrides      UserCapabilityOverride[]
}

model BranchPublicProfile {
  branchId           String   @id @db.Char(36)
  slug               String   @unique
  area               String
  city               String
  address            String
  latitude           Float?
  longitude          Float?
  openingHours       Json
  description        String   @db.Text
  arrivalInformation String?  @db.Text
  parkingInformation String?  @db.Text
  amenities          Json
  heroImageKey       String
  galleryImageKeys   Json
  version            Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  branch             Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([city, area])
}

model PublicClassProfile {
  code            String   @id
  slug            String   @unique
  summary         String
  description     String   @db.Text
  level           String
  durationMinutes Int
  equipment       Json
  benefits        Json
  heroImageKey    String
  active          Boolean  @default(true)
  version         Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ClassType {
  id               String                   @id @db.Char(36)
  branchId         String                   @db.Char(36)
  code             String
  name             String
  active           Boolean                  @default(true)
  version          Int                      @default(0)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  branch           Branch                   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  configurations   EffectiveConfiguration[]
  packages         Package[]
  voucherScopes    Voucher[]
  customerPackages CustomerPackage[]
  classSlots       ClassSlot[]

  @@unique([branchId, code])
  @@index([branchId, active])
}

model Assignment {
  id                       String                   @id @db.Char(36)
  userId                   String                   @db.Char(36)
  branchId                 String                   @db.Char(36)
  type                     AssignmentType
  activeFrom               DateTime                 @db.Date
  activeUntil              DateTime?                @db.Date
  version                  Int                      @default(0)
  user                     User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  branch                   Branch                   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  projectedRole            UserRole?                @relation("AssignmentRoleProjection")
  instructorAvailabilities InstructorAvailability[]

  @@index([userId, activeFrom, activeUntil])
  @@index([branchId, type, activeFrom, activeUntil])
}

model InstructorAvailability {
  id                 String     @id @db.Char(36)
  instructorUserId   String     @db.Char(36)
  branchId           String     @db.Char(36)
  sourceAssignmentId String     @db.Char(36)
  startAt            DateTime
  endAt              DateTime
  timezone           String
  version            Int        @default(0)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  instructor         User       @relation(fields: [instructorUserId], references: [id], onDelete: Restrict)
  branch             Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  sourceAssignment   Assignment @relation(fields: [sourceAssignmentId], references: [id], onDelete: Restrict)

  @@index([instructorUserId, startAt, id])
  @@index([branchId, startAt, endAt])
}

model ClassSlot {
  id                     String                           @id @db.Char(36)
  branchId               String                           @db.Char(36)
  classTypeId            String                           @db.Char(36)
  instructorUserId       String?                          @db.Char(36)
  startAt                DateTime
  endAt                  DateTime
  timezone               String
  minimumQuota           Int
  capacity               Int
  bookedCount            Int                              @default(0)
  status                 ClassSlotStatus                  @default(DRAFT)
  cancellationReasonCode ClassSlotCancellationReasonCode?
  version                Int                              @default(0)
  createdAt              DateTime                         @default(now())
  updatedAt              DateTime                         @updatedAt
  branch                 Branch                           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  classType              ClassType                        @relation(fields: [classTypeId], references: [id], onDelete: Restrict)
  instructor             User?                            @relation("ClassSlotInstructor", fields: [instructorUserId], references: [id], onDelete: Restrict)
  reservations           SessionReservation[]
  bookings               Booking[]
  customerAttendances    CustomerAttendance[]
  continuationPurchases  Purchase[]                       @relation("PurchaseContinuationSlot")
  sourceReschedules      Reschedule[]                     @relation("RescheduleSourceSlot")
  targetReschedules      Reschedule[]                     @relation("RescheduleTargetSlot")
  quotaEvaluationJob     QuotaEvaluationJob?

  @@index([branchId, startAt, id])
  @@index([instructorUserId, startAt, endAt])
  @@index([status, startAt])
}

model QuotaEvaluationJob {
  id             String                   @id @db.Char(36)
  classSlotId    String                   @unique @db.Char(36)
  evaluationKey  String                   @unique
  dueAt          DateTime
  status         QuotaEvaluationJobStatus @default(QUEUED)
  leaseOwner     String?
  leaseExpiresAt DateTime?
  attempts       Int                      @default(0)
  maxAttempts    Int
  nextAttemptAt  DateTime
  lastErrorCode  String?
  result         Json?
  version        Int                      @default(0)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  classSlot      ClassSlot                @relation(fields: [classSlotId], references: [id], onDelete: Restrict)

  @@index([status, dueAt, nextAttemptAt])
  @@index([leaseExpiresAt])
}

model UserRole {
  id                 String          @id @default(uuid()) @db.Char(36)
  userId             String          @db.Char(36)
  role               ApplicationRole
  branchId           String?         @db.Char(36)
  activeFrom         DateTime
  activeUntil        DateTime?
  sourceAssignmentId String?         @unique @db.Char(36)
  createdAt          DateTime        @default(now())
  user               User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  branch             Branch?         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  sourceAssignment   Assignment?     @relation("AssignmentRoleProjection", fields: [sourceAssignmentId], references: [id], onDelete: Restrict)

  @@index([userId, activeFrom, activeUntil])
  @@index([branchId, role, activeFrom, activeUntil])
}

model CapabilityDefinition {
  key              String                   @id @db.VarChar(96)
  label            String                   @db.VarChar(160)
  description      String                   @db.VarChar(500)
  category         String                   @db.VarChar(64)
  sensitive        Boolean                  @default(false)
  active           Boolean                  @default(true)
  systemOnly       Boolean                  @default(false)
  globalOnly       Boolean                  @default(false)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  roleCapabilities RoleCapability[]
  userOverrides    UserCapabilityOverride[]
}

model RoleDefinition {
  id           String                 @id @db.Char(36)
  code         String                 @unique @db.VarChar(64)
  displayName  String                 @db.VarChar(160)
  description  String                 @db.VarChar(500)
  scope        AccessRoleScope
  systemRole   ApplicationRole?       @unique
  system       Boolean                @default(false)
  protected    Boolean                @default(false)
  active       Boolean                @default(true)
  version      Int                    @default(0)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  capabilities RoleCapability[]
  assignments  AccessRoleAssignment[]

  @@index([active, scope, code])
}

model RoleCapability {
  roleId        String               @db.Char(36)
  capabilityKey String               @db.VarChar(96)
  createdAt     DateTime             @default(now())
  role          RoleDefinition       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  capability    CapabilityDefinition @relation(fields: [capabilityKey], references: [key], onDelete: Restrict)

  @@id([roleId, capabilityKey])
  @@index([capabilityKey])
}

model AccessRoleAssignment {
  id          String         @id @default(uuid()) @db.Char(36)
  userId      String         @db.Char(36)
  roleId      String         @db.Char(36)
  branchId    String?        @db.Char(36)
  activeFrom  DateTime
  activeUntil DateTime?
  createdAt   DateTime       @default(now())
  user        User           @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  role        RoleDefinition @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  branch      Branch?        @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, activeFrom, activeUntil])
  @@index([roleId, branchId, activeFrom, activeUntil])
  @@index([branchId])
}

model UserCapabilityOverride {
  id            String                   @id @default(uuid()) @db.Char(36)
  userId        String                   @db.Char(36)
  capabilityKey String                   @db.VarChar(96)
  branchId      String?                  @db.Char(36)
  effect        CapabilityOverrideEffect
  reasonCode    String                   @db.VarChar(64)
  note          String?                  @db.VarChar(500)
  createdById   String                   @db.Char(36)
  revokedAt     DateTime?
  revokedById   String?                  @db.Char(36)
  revokeReason  String?                  @db.VarChar(64)
  version       Int                      @default(0)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  user          User                     @relation("CapabilityOverrideTarget", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  capability    CapabilityDefinition     @relation(fields: [capabilityKey], references: [key], onDelete: Restrict, onUpdate: Restrict)
  branch        Branch?                  @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy     User                     @relation("CapabilityOverrideCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revokedBy     User?                    @relation("CapabilityOverrideRevoker", fields: [revokedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, revokedAt, capabilityKey])
  @@index([branchId, capabilityKey, revokedAt])
  @@index([createdById])
  @@index([revokedById])
}

model UserSession {
  id               String         @id @default(uuid()) @db.Char(36)
  userId           String         @db.Char(36)
  channel          SessionChannel
  tokenFamilyHash  String
  accessTokenHash  String         @unique
  refreshTokenHash String?        @unique
  expiresAt        DateTime
  refreshExpiresAt DateTime?
  revokedAt        DateTime?
  revocationReason String?
  createdAt        DateTime       @default(now())
  rotatedAt        DateTime?
  user             User           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt, revokedAt])
  @@index([tokenFamilyHash, revokedAt])
}

model AuthChallenge {
  id          String          @id @default(uuid()) @db.Char(36)
  userId      String?         @db.Char(36)
  kind        ChallengeKind
  purpose     String
  subjectHash String
  proofHash   String
  status      ChallengeStatus @default(PENDING)
  attempts    Int             @default(0)
  maxAttempts Int
  expiresAt   DateTime
  verifiedAt  DateTime?
  createdAt   DateTime        @default(now())
  user        User?           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([kind, subjectHash, createdAt])
  @@index([status, expiresAt])
}

model UserInvitation {
  id               String                @id @default(uuid()) @db.Char(36)
  invitedById      String                @db.Char(36)
  userId           String?               @unique @db.Char(36)
  identityProvider IdentityProvider      @default(GOOGLE)
  subjectHash      String
  emailHash        String?
  displayName      String?
  roles            Json
  branchIds        Json
  status           InvitationStatus      @default(PENDING)
  expiresAt        DateTime
  acceptedAt       DateTime?
  createdAt        DateTime              @default(now())
  invitedBy        User                  @relation("InvitationCreator", fields: [invitedById], references: [id], onDelete: Restrict)
  user             User?                 @relation("InvitationTarget", fields: [userId], references: [id], onDelete: Restrict)
  passwordActions  PasswordActionToken[]

  @@index([identityProvider, subjectHash, status, expiresAt])
  @@index([emailHash, status, expiresAt])
  @@index([invitedById, createdAt])
}

model PasswordCredential {
  id                String   @id @default(uuid()) @db.Char(36)
  userId            String   @unique @db.Char(36)
  emailHash         String   @unique
  passwordHash      String
  verifiedAt        DateTime
  passwordChangedAt DateTime
  version           Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model PasswordActionToken {
  id           String             @id @default(uuid()) @db.Char(36)
  kind         PasswordActionKind
  tokenHash    String             @unique
  emailHash    String
  userId       String?            @db.Char(36)
  invitationId String?            @db.Char(36)
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime           @default(now())
  user         User?              @relation(fields: [userId], references: [id], onDelete: Restrict)
  invitation   UserInvitation?    @relation(fields: [invitationId], references: [id], onDelete: Restrict)

  @@index([emailHash, kind, expiresAt])
  @@index([userId, kind, expiresAt])
}

model RateLimitCounter {
  id          String   @id @default(uuid()) @db.Char(36)
  scope       String
  subjectHash String
  windowStart DateTime
  attempts    Int      @default(1)
  expiresAt   DateTime

  @@unique([scope, subjectHash, windowStart])
  @@index([expiresAt])
}

model AuditLog {
  id            String   @id @db.Char(36)
  occurredAt    DateTime @default(now())
  actorType     String
  actorId       String?  @db.Char(36)
  branchId      String?  @db.Char(36)
  action        String
  objectType    String
  objectId      String
  targetUserId  String?  @db.Char(36)
  beforeMasked  Json?
  afterMasked   Json?
  correlationId String

  @@index([branchId, occurredAt])
  @@index([objectType, objectId, occurredAt])
  @@index([targetUserId, occurredAt])
}

enum AuditExportStatus {
  QUEUED
  RUNNING
  READY
  FAILED
  EXPIRED
}

enum AuditExportFormat {
  CSV
  JSONL
}

model AuditExport {
  id                 String            @id @db.Char(36)
  requestedById      String            @db.Char(36)
  idempotencyKeyHash String
  requestHash        String
  branchIds          Json
  from               DateTime
  until              DateTime
  actorId            String?           @db.Char(36)
  objectType         String?
  format             AuditExportFormat
  reasonPresent      Boolean           @default(true)
  status             AuditExportStatus @default(QUEUED)
  rowCount           Int               @default(0)
  content            String?           @db.LongText
  failureCode        String?
  downloadTokenHash  String?
  downloadExpiresAt  DateTime?
  requestedAt        DateTime          @default(now())
  completedAt        DateTime?
  expiresAt          DateTime
  version            Int               @default(0)

  @@unique([requestedById, idempotencyKeyHash])
  @@index([requestedById, requestedAt])
  @@index([status, requestedAt])
  @@index([expiresAt])
}

model IdempotencyRecord {
  id              String            @id @db.Char(36)
  scope           String
  keyHash         String
  requestHash     String
  status          IdempotencyStatus @default(IN_PROGRESS)
  responseStatus  Int?
  responseBody    Json?
  responseHeaders Json?
  createdAt       DateTime          @default(now())
  completedAt     DateTime?
  leaseExpiresAt  DateTime
  expiresAt       DateTime

  @@unique([scope, keyHash])
  @@index([expiresAt])
  @@index([status, leaseExpiresAt])
}

model OutboxEvent {
  id                      String                   @id @db.Char(36)
  eventType               String
  aggregateType           String
  aggregateId             String
  payload                 Json
  correlationId           String
  status                  OutboxStatus             @default(PENDING)
  occurredAt              DateTime                 @default(now())
  publishedAt             DateTime?
  attempts                Int                      @default(0)
  notificationProjection  NotificationProjection?
  userNotifications       UserNotification[]
  notificationOccurrences NotificationOccurrence[]

  @@index([status, occurredAt])
  @@index([aggregateType, aggregateId])
}

model NotificationOccurrence {
  id                 String                     @id @db.Char(36)
  occurrenceKey      String                     @unique
  sourceEventId      String?                    @db.Char(36)
  userId             String?                    @db.Char(36)
  branchId           String?                    @db.Char(36)
  channel            NotificationChannel        @default(EMAIL)
  eventType          String
  templateKey        String
  templateVersion    Int                        @default(1)
  recipientHash      String
  recipientMasked    String
  envelopeEncrypted  String?                    @db.LongText
  status             NotificationDeliveryStatus @default(PENDING)
  attemptCount       Int                        @default(0)
  rateLimitWaitCount Int                        @default(0)
  maxAttempts        Int                        @default(5)
  nextAttemptAt      DateTime                   @default(now())
  leaseExpiresAt     DateTime?
  lastErrorCode      String?
  correlationId      String
  expiresAt          DateTime?
  acceptedAt         DateTime?
  fallbackCreatedAt  DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  sourceEvent        OutboxEvent?               @relation(fields: [sourceEventId], references: [id], onDelete: SetNull)
  user               User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  attempts           NotificationAttempt[]

  @@index([status, nextAttemptAt])
  @@index([userId, createdAt])
  @@index([sourceEventId])
  @@index([branchId, createdAt])
}

model NotificationAttempt {
  id            String                     @id @db.Char(36)
  occurrenceId  String                     @db.Char(36)
  attemptNumber Int
  status        NotificationDeliveryStatus
  providerCode  String?
  errorCode     String?
  startedAt     DateTime                   @default(now())
  completedAt   DateTime?
  occurrence    NotificationOccurrence     @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)

  @@unique([occurrenceId, attemptNumber])
  @@index([status, startedAt])
}

model NotificationProjection {
  id            String                       @id @db.Char(36)
  sourceEventId String                       @unique @db.Char(36)
  status        NotificationProjectionStatus
  errorCode     String?
  projectedAt   DateTime                     @default(now())
  sourceEvent   OutboxEvent                  @relation(fields: [sourceEventId], references: [id], onDelete: Cascade)

  @@index([status, projectedAt])
}

model UserNotification {
  id             String               @id @db.Char(36)
  userId         String               @db.Char(36)
  branchId       String?              @db.Char(36)
  sourceEventId  String?              @db.Char(36)
  eventKey       String
  category       NotificationCategory
  tone           NotificationTone
  title          String
  message        String
  href           String?
  metadataMasked Json?
  readAt         DateTime?
  expiresAt      DateTime?
  createdAt      DateTime             @default(now())
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch         Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  sourceEvent    OutboxEvent?         @relation(fields: [sourceEventId], references: [id], onDelete: SetNull)

  @@unique([userId, eventKey])
  @@index([userId, readAt, createdAt])
  @@index([userId, expiresAt])
  @@index([branchId, createdAt])
}

model Package {
  id               String                @id @db.Char(36)
  branchId         String                @db.Char(36)
  classTypeId      String                @db.Char(36)
  businessKey      String
