  viewAuthorizations    PaymentProofViewAuthorization[]

  @@index([userId, branchId, scanStatus])
}

model PaymentProofViewAuthorization {
  id         String       @id @db.Char(36)
  proofId    String       @db.Char(36)
  viewerId   String       @db.Char(36)
  purpose    String       @default("REVIEW") @db.VarChar(24)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime     @default(now())
  proof      PaymentProof @relation(fields: [proofId], references: [id], onDelete: Restrict)
  viewer     User         @relation("PaymentProofViewer", fields: [viewerId], references: [id], onDelete: Restrict)

  @@index([viewerId, expiresAt])
  @@index([proofId, expiresAt])
}

model PaymentAccount {
  id                     String                         @id @db.Char(36)
  branchId               String                         @db.Char(36)
  activeBranchKey        String?                        @unique @db.Char(36)
