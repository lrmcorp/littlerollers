  customer       User      @relation(fields: [customerUserId], references: [id], onDelete: Restrict)

  @@unique([voucherId, customerUserId, purchaseId])
  @@index([voucherId, redeemedAt])
  @@index([customerUserId, voucherId, redeemedAt])
}

model PurchaseTimelineEvent {
