{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dailydose.internal/schemas/v1-storage-manifest.schema.json",
  "title": "Daily Dose v1 storage migration manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["entries"],
  "properties": {
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourcePath",
        "localPath",
        "objectKey",
        "checksum",
        "mimeType",
        "sizeBytes"
      ],
      "properties": {
        "sourcePath": { "type": "string", "minLength": 1 },
        "localPath": { "type": "string", "minLength": 1 },
        "objectKey": { "type": "string", "minLength": 1 },
        "checksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "mimeType": { "type": "string", "minLength": 1 },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "scanStatus": {
          "type": "string",
          "enum": ["PENDING", "CLEAN", "REJECTED", "INFECTED", "ERROR"]
        }
      }
    }
  }
}
