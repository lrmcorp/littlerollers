enum ClassSlotStatus {
  DRAFT
  PUBLISHED
  CONFIRMED
  AUTO_CANCELLED
  CANCELLED
  COMPLETED
}

enum ClassModality {
  GROUP
  PRIVATE
  HYBRID
  UNKNOWN_LEGACY
}

enum ClassSlotCancellationReasonCode {
  STUDIO_UNAVAILABLE
  INSTRUCTOR_UNAVAILABLE
  SAFETY_ISSUE
  OTHER_REVIEW_REQUIRED
}

model KetersediaanInstruktur {
  id                 String     @id @db.Char(36)
  instructorUserId   String     @db.Char(36)
  branchId           String     @db.Char(36)
  sourceAssignmentId String     @db.Char(36)
  startAt            DateTime
  endAt              DateTime
  timezone           String
  version            Int        @default(0)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  instructor         User       @relation(fields: [instructorUserId], references: [id], onDelete: Restrict)
  branch             Cabang     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  sourceAssignment   Penugasan @relation(fields: [sourceAssignmentId], references: [id], onDelete: Restrict)

  @@index([instructorUserId, startAt, id])
  @@index([branchId, startAt, endAt])

  @@map("KetersediaanInstruktur")
}

model SlotKelas {
  id                      String                           @id @db.Char(36)
  branchId                String                           @db.Char(36) @map("cabang_id")
  classTypeId             String                           @db.Char(36) @map("jenis_kelas_id")
  studioId                String                           @db.Char(36) @map("studio_id")
  roomId                  String?                          @db.Char(36) @map("ruangan_id")
  instructorUserId        String?                          @db.Char(36) @map("pengguna_instruktur_id")
  startAt                 DateTime @map("waktu_mulai")
  endAt                   DateTime @map("waktu_selesai")
  timezone                String
  minimumQuota            Int
  capacity                Int @map("kapasitas")
  bookedCount             Int                              @default(0)
  status                  ClassSlotStatus                  @default(DRAFT) @map("status")
  cancellationReasonCode  ClassSlotCancellationReasonCode?
  version                 Int                              @default(0)
  createdAt               DateTime                         @default(now())
  updatedAt               DateTime                         @updatedAt
  branch                  Cabang                           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  classType               JenisKelas                        @relation(fields: [classTypeId], references: [id], onDelete: Restrict)
  studio                  Studio                           @relation(fields: [studioId], references: [id], onDelete: Restrict)
  room                    Ruangan?                            @relation(fields: [roomId], references: [id], onDelete: Restrict)
  instructor              User?                            @relation("ClassSlotInstructor", fields: [instructorUserId], references: [id], onDelete: Restrict)
  reservations            ReservasiSesi[]
  bookings                PemesananKelas[]
  customerAttendances     KehadiranPelanggan[]
  instructorCheckInTokens InstructorCheckInToken[]
  instructorAttendances   KehadiranInstruktur[]
  instructorHourLog       RekapJamInstruktur?
  continuationPurchases   Pembelian[]                       @relation("PurchaseContinuationSlot")
  sourceReschedules       UbahJadwal[]                     @relation("RescheduleSourceSlot")
  targetReschedules       UbahJadwal[]                     @relation("RescheduleTargetSlot")
  quotaEvaluationJob      QuotaEvaluationJob?
  historical              Boolean                          @default(false)
  sourceDeletedAt         DateTime?
  sourceMetadata          Json?

  @@index([branchId, startAt, id])
  @@index([studioId, startAt, id])
  @@index([roomId, startAt, id])
  @@index([instructorUserId, startAt, endAt])
  @@index([status, startAt])

  @@map("SlotKelas")
}
