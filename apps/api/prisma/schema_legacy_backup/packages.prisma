enum PackageStatus {
  ACTIVE
  INACTIVE
}

enum VoucherStatus {
  DRAFT
  ACTIVE
  PAUSED
  EXPIRED
  EXHAUSTED
  ARCHIVED
}

enum VoucherDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PackagePromotionStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum PaymentProofUploadStatus {
  ISSUED
  UPLOADED
  FINALIZED
  FAILED
}

enum PaymentProofScanStatus {
  PENDING
  CLEAN
  REJECTED
  INFECTED
  ERROR
}

enum PurchaseStatus {
  AWAITING_PAYMENT
  PENDING
  ACTION_REQUIRED
  APPROVED
  REJECTED
  EXPIRED
}

enum PurchaseTimelineEventType {
  ORDER_CREATED
  PAYMENT_DEADLINE_SET
  PROOF_SUBMITTED
  PROOF_SCAN_COMPLETED
  ACTION_REQUIRED
  PAYMENT_APPROVED
  PAYMENT_REJECTED
  ORDER_EXPIRED
  PACKAGE_ACTIVATED
}

enum CustomerPackageStatus {
  ACTIVE
  INACTIVE
}

enum PurchaseSnapshotCompleteness {
  COMPLETE_BREAKDOWN
  LEGACY_FINAL_AMOUNT_ONLY
}

model Paket {
  id               String                  @id @db.Char(36)
  /// Compatibility projection only. Availability is authoritative in branchScopes.
  branchId         String?                 @db.Char(36)
  /// Compatibility projection only. Eligibility is authoritative in classTypeScopes.
  classTypeId      String?                 @db.Char(36)
  businessKey      String @map("kunci_bisnis")
  name             String @map("nama")
  sessionCount     Int @map("jumlah_sesi")
  durationDays     Int @map("durasi_hari")
  priceRp          Int @map("harga_rp")
  effectiveFrom    DateTime                @db.Date @map("berlaku_dari")
  effectiveUntil   DateTime?               @db.Date @map("berlaku_sampai")
  status           PackageStatus           @default(ACTIVE) @map("status")
  version          Int                     @default(0) @map("versi")
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  branch           Cabang?                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  classType        JenisKelas?              @relation(fields: [classTypeId], references: [id], onDelete: Restrict)
  revisions        RevisiPaket[]
  branchScopes     CakupanCabangPaket[]
  classTypeScopes  CakupanJenisKelasPaket[]
  proofs           BuktiPembayaran[]
  purchases        Pembelian[]
  customerPackages PaketPelanggan[]
  publicProfile    ProfilPublikPaket?
  voucherScopes    CakupanPaketVoucher[]
  promotions       PromosiPaket[]
  historical       Boolean                 @default(false)
  sourceDeletedAt  DateTime?
  sourceMetadata   Json?

  @@index([branchId, status, effectiveFrom, effectiveUntil])
  @@index([classTypeId, businessKey, effectiveFrom])

  @@map("Paket")
}

model RevisiPaket {
  id               String    @id @default(uuid()) @db.Char(36)
  packageId        String    @db.Char(36)
  revisionNumber   Int
  sessionCount     Int
  durationDays     Int
  priceRp          Int
  promoteCode      String?   @db.VarChar(64)
  discountRp       Int?
  manyTimesAllowed Boolean   @default(false)
  visible          Boolean   @default(true)
  effectiveFrom    DateTime  @db.Date
  effectiveUntil   DateTime? @db.Date
  historical       Boolean   @default(false)
  sourceDeletedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  package          Paket   @relation(fields: [packageId], references: [id], onDelete: Restrict)

  @@unique([packageId, revisionNumber])
  @@index([packageId, effectiveFrom, effectiveUntil])

  @@map("RevisiPaket")
}

model CakupanCabangPaket {
  id              String    @id @default(uuid()) @db.Char(36)
  packageId       String    @db.Char(36)
  branchId        String    @db.Char(36)
  active          Boolean   @default(true)
  historical      Boolean   @default(false)
  sourceDeletedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  package         Paket   @relation(fields: [packageId], references: [id], onDelete: Restrict)
  branch          Cabang    @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([packageId, branchId])
  @@index([branchId, active])

  @@map("CakupanCabangPaket")
}

model CakupanJenisKelasPaket {
  id              String    @id @default(uuid()) @db.Char(36)
  packageId       String    @db.Char(36)
  classTypeId     String    @db.Char(36)
  active          Boolean   @default(true)
  historical      Boolean   @default(false)
  sourceDeletedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  package         Paket   @relation(fields: [packageId], references: [id], onDelete: Restrict)
  classType       JenisKelas @relation(fields: [classTypeId], references: [id], onDelete: Restrict)

  @@unique([packageId, classTypeId])
  @@index([classTypeId, active])

  @@map("CakupanJenisKelasPaket")
}

model ProfilPublikPaket {
  packageId     String   @id @db.Char(36)
  summary       String
  description   String   @db.Text
  highlights    Json
  usageGuidance String   @db.Text
  terms         Json
  version       Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  package       Paket  @relation(fields: [packageId], references: [id], onDelete: Restrict)

  @@map("ProfilPublikPaket")
}

model BuktiPembayaran {
  id                    String                          @id @db.Char(36)
  userId                String                          @db.Char(36) @map("pengguna_id")
  branchId              String                          @db.Char(36) @map("cabang_id")
  packageId             String?                         @db.Char(36)
  objectKey             String                          @unique
  checksum              String
  fileName              String @map("nama_file")
  mimeType              String @map("tipe_mime")
  sizeBytes             Int @map("ukuran_byte")
  uploadStatus          PaymentProofUploadStatus        @default(ISSUED) @map("status_unggahan")
  scanStatus            PaymentProofScanStatus          @default(PENDING) @map("status_pemindaian")
  providerReferenceHash String?
  issuedAt              DateTime                        @default(now())
  uploadedAt            DateTime?
  finalizedAt           DateTime?
  replacedById          String?                         @db.Char(36)
  version               Int                             @default(0)
  user                  User                            @relation(fields: [userId], references: [id], onDelete: Restrict)
  branch                Cabang                          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  package               Paket?                        @relation(fields: [packageId], references: [id], onDelete: Restrict)
  purchase              Pembelian?
  replacedBy            BuktiPembayaran?                   @relation("PaymentProofReplacement", fields: [replacedById], references: [id], onDelete: Restrict)
  replaces              BuktiPembayaran[]                  @relation("PaymentProofReplacement")
  viewAuthorizations    OtorisasiLihatBuktiPembayaran[]

  @@index([userId, branchId, scanStatus])

  @@map("BuktiPembayaran")
}

model OtorisasiLihatBuktiPembayaran {
  id         String       @id @db.Char(36)
  proofId    String       @db.Char(36)
  viewerId   String       @db.Char(36)
  purpose    String       @default("REVIEW") @db.VarChar(24)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime     @default(now())
  proof      BuktiPembayaran @relation(fields: [proofId], references: [id], onDelete: Restrict)
  viewer     User         @relation("PaymentProofViewer", fields: [viewerId], references: [id], onDelete: Restrict)

  @@index([viewerId, expiresAt])
  @@index([proofId, expiresAt])

  @@map("OtorisasiLihatBuktiPembayaran")
}

model RekeningPembayaran {
  id                     String                         @id @db.Char(36)
  branchId               String                         @db.Char(36) @map("cabang_id")
  activeBranchKey        String?                        @unique @db.Char(36)
  bankCode               String @map("kode_bank")
  bankName               String @map("nama_bank")
  accountNumberEncrypted String                         @db.Text @map("nomor_rekening_terenkripsi")
  accountNumberLast4     String                         @db.VarChar(4) @map("nomor_rekening_4_digit_terakhir")
  accountHolderName      String @map("nama_pemilik_rekening")
  paymentWindowHours     Int                            @default(24) @map("durasi_pembayaran_jam")
  active                 Boolean                        @default(true) @map("aktif")
  version                Int                            @default(0)
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt
  branch                 Cabang                         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  purchases              Pembelian[]
  uniqueCodeReservations ReservasiKodeUnikPembayaran[]

  @@index([branchId, active])

  @@map("RekeningPembayaran")
}

model Pembelian {
  id                                    String                        @id @db.Char(36)
  userId                                String                        @db.Char(36) @map("pengguna_id")
  branchId                              String                        @db.Char(36) @map("cabang_id")
  packageId                             String                        @db.Char(36) @map("paket_id")
  classTypeId                           String                        @db.Char(36) @map("jenis_kelas_id")
  voucherId                             String?                       @db.Char(36) @map("voucher_id")
  packagePromotionId                    String?                       @db.Char(36)
  packagePromotionNameSnapshot          String?                       @db.VarChar(160)
  packagePromotionDiscountTypeSnapshot  VoucherDiscountType?
  packagePromotionDiscountValueSnapshot Int?
  packagePromotionDiscountRpSnapshot    Int?
  promotionalPriceRpSnapshot            Int? @map("snapshot_harga_promosi_rp")
  voucherCodeSnapshot                   String?                       @db.VarChar(64) @map("snapshot_kode_voucher")
  voucherDiscountTypeSnapshot           VoucherDiscountType?
  voucherDiscountValueSnapshot          Int?
  voucherDiscountRpSnapshot             Int? @map("snapshot_diskon_voucher_rp")
  priceAfterDiscountRpSnapshot          Int? @map("snapshot_harga_setelah_diskon_rp")
  paymentProofId                        String?                       @unique @db.Char(36)
  paymentAccountId                      String?                       @db.Char(36)
  paymentBankNameSnapshot               String?
  paymentAccountNumberSnapshotEncrypted String?                       @db.Text
  paymentAccountLast4Snapshot           String?                       @db.VarChar(4)
  paymentAccountHolderSnapshot          String?
  paymentExpiresAt                      DateTime? @map("batas_waktu_pembayaran")
  continuationClassSlotId               String?                       @db.Char(36)
  packageNameSnapshot                   String @map("snapshot_nama_paket")
  priceRpSnapshot                       Int @map("snapshot_harga_rp")
  catalogAmountRpSnapshot               Int?
  discountAmountRpSnapshot              Int?
  finalAmountBeforeUniqueCodeRpSnapshot Int?
  paymentUniqueCode                     Int? @map("kode_unik_pembayaran")
  payableAmountRpSnapshot               Int? @map("snapshot_jumlah_tagihan_rp")
  amountPaidRpSnapshot                  Int?
  paymentMethodCode                     String?                       @db.VarChar(64)
  sourceStatusCode                      String?                       @db.VarChar(64)
  sourceActiveFlag                      Boolean?
  snapshotCompleteness                  PurchaseSnapshotCompleteness  @default(COMPLETE_BREAKDOWN)
  sessionCountSnapshot                  Int
  durationDaysSnapshot                  Int
  status                                PurchaseStatus                @default(PENDING) @map("status")
  idempotencyKeyHash                    String
  submittedAt                           DateTime                      @default(now()) @map("diajukan_pada")
  decidedAt                             DateTime? @map("diputuskan_pada")
  decidedById                           String?                       @db.Char(36) @map("diputuskan_oleh_id")
  decisionReasonCode                    String? @map("kode_alasan_keputusan")
  timelineComplete                      Boolean                       @default(false)
  version                               Int                           @default(0)
  user                                  User                          @relation(fields: [userId], references: [id], onDelete: Restrict)
  branch                                Cabang                        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  package                               Paket                       @relation(fields: [packageId], references: [id], onDelete: Restrict)
  classType                             JenisKelas                     @relation(fields: [classTypeId], references: [id], onDelete: Restrict)
  voucher                               Voucher?                      @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  packagePromotion                      PromosiPaket?             @relation(fields: [packagePromotionId], references: [id], onDelete: Restrict)
  paymentProof                          BuktiPembayaran?                 @relation(fields: [paymentProofId], references: [id], onDelete: Restrict)
  paymentAccount                        RekeningPembayaran?               @relation(fields: [paymentAccountId], references: [id], onDelete: Restrict)
  continuationClassSlot                 SlotKelas?                    @relation("PurchaseContinuationSlot", fields: [continuationClassSlotId], references: [id], onDelete: Restrict)
  decidedBy                             User?                         @relation("PurchaseDecisionActor", fields: [decidedById], references: [id], onDelete: Restrict)
  customerPackage                       PaketPelanggan?
  paymentUniqueCodeReservation          ReservasiKodeUnikPembayaran?
  timelineEvents                        PeristiwaLinimasaPembelian[]
  voucherRedemption                     PenukaranVoucher?
  journalEntries                        EntriJurnal[]
  legacyFinancialEntries                EntriKeuanganHistoris[]
  customerVoucherEntitlements           HakVoucherPelanggan[]
  historical                            Boolean                       @default(false)
  sourceDeletedAt                       DateTime?
  sourceMetadata                        Json?

  @@unique([userId, idempotencyKeyHash])
  @@index([userId, submittedAt])
  @@index([branchId, status])
  @@index([classTypeId])
  @@index([paymentAccountId, status, paymentExpiresAt])
  @@index([packagePromotionId, submittedAt])

  @@map("Pembelian")
}

model PromosiPaket {
  id            String                 @id @db.Char(36)
  packageId     String                 @db.Char(36)
  name          String                 @db.VarChar(160)
  label         String                 @db.VarChar(80)
  status        PackagePromotionStatus @default(DRAFT)
  discountType  VoucherDiscountType
  discountValue Int
  activeFrom    DateTime
  activeUntil   DateTime
  version       Int                    @default(0)
  createdById   String                 @db.Char(36)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  package       Paket                @relation(fields: [packageId], references: [id], onDelete: Restrict)
  createdBy     User                   @relation("PackagePromotionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  purchases     Pembelian[]

  @@index([packageId, status, activeFrom, activeUntil])
  @@index([status, activeFrom, activeUntil])

  @@map("PromosiPaket")
}

model Voucher {
  id                            String                       @id @db.Char(36)
  code                          String                       @unique @db.VarChar(64) @map("kode")
  name                          String                       @db.VarChar(160) @map("nama")
  description                   String?                      @db.Text @map("deskripsi")
  status                        VoucherStatus                @default(DRAFT) @map("status")
  discountType                  VoucherDiscountType @map("tipe_diskon")
  discountValue                 Int @map("nilai_diskon")
  maxDiscountRp                 Int? @map("maksimal_diskon_rp")
  minimumPurchaseRp             Int                          @default(0) @map("minimal_pembelian_rp")
  activeFrom                    DateTime @map("aktif_dari")
  activeUntil                   DateTime? @map("aktif_sampai")
  totalUsageLimit               Int? @map("batas_total_penggunaan")
  perCustomerUsageLimit         Int? @map("batas_penggunaan_per_pelanggan")
  legacyEntitlementDurationDays Int?
  branchId                      String?                      @db.Char(36)
  classTypeId                   String?                      @db.Char(36)
  version                       Int                          @default(0)
  createdById                   String                       @db.Char(36)
  createdAt                     DateTime                     @default(now())
  updatedAt                     DateTime                     @updatedAt
  branch                        Cabang?                      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  classType                     JenisKelas?                   @relation(fields: [classTypeId], references: [id], onDelete: Restrict)
  createdBy                     User                         @relation("VoucherCreator", fields: [createdById], references: [id], onDelete: Restrict)
  packages                      CakupanPaketVoucher[]
  redemptions                   PenukaranVoucher[]
  purchases                     Pembelian[]
  historical                    Boolean                      @default(false)
  sourceDeletedAt               DateTime?
  sourceMetadata                Json?
  codeAliases                   AliasKodeVoucher[]
  customerEntitlements          HakVoucherPelanggan[]

  @@index([status, activeFrom, activeUntil])
  @@index([branchId, status])
  @@index([classTypeId, status])
}

model AliasKodeVoucher {
  id              String    @id @db.Char(36)
  voucherId       String    @db.Char(36)
  code            String    @db.VarChar(64)
  canonical       Boolean   @default(false)
  historical      Boolean   @default(true)
  sourceDeletedAt DateTime?
  createdAt       DateTime  @default(now())
  voucher         Voucher   @relation(fields: [voucherId], references: [id], onDelete: Restrict)

  @@unique([voucherId, code])
  @@index([code])

  @@map("AliasKodeVoucher")
}

model CakupanPaketVoucher {
  id        String  @id @db.Char(36)
  voucherId String  @db.Char(36)
  packageId String  @db.Char(36)
  voucher   Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  package   Paket @relation(fields: [packageId], references: [id], onDelete: Restrict)

  @@unique([voucherId, packageId])
  @@index([packageId])

  @@map("CakupanPaketVoucher")
}

model PenukaranVoucher {
  id                   String                       @id @db.Char(36)
  voucherId            String                       @db.Char(36)
  purchaseId           String                       @unique @db.Char(36)
  customerUserId       String                       @db.Char(36)
  discountRp           Int
  snapshotCompleteness PurchaseSnapshotCompleteness @default(COMPLETE_BREAKDOWN)
  redeemedAt           DateTime                     @default(now())
  releasedAt           DateTime?
  voucher              Voucher                      @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  purchase             Pembelian                     @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  customer             User                         @relation(fields: [customerUserId], references: [id], onDelete: Restrict)

  @@unique([voucherId, customerUserId, purchaseId])
  @@index([voucherId, redeemedAt])
  @@index([customerUserId, voucherId, redeemedAt])

  @@map("PenukaranVoucher")
}

model HakVoucherPelanggan {
  id               String    @id @db.Char(36)
  voucherId        String    @db.Char(36)
  customerUserId   String    @db.Char(36)
  purchaseId       String?   @db.Char(36)
  sourceStatusCode String    @db.VarChar(64)
  active           Boolean   @default(true)
  expiresAt        DateTime?
  usedAt           DateTime?
  historical       Boolean   @default(false)
  sourceDeletedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  voucher          Voucher   @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  customer         User      @relation(fields: [customerUserId], references: [id], onDelete: Restrict)
  purchase         Pembelian? @relation(fields: [purchaseId], references: [id], onDelete: Restrict)

  @@index([customerUserId, active, expiresAt])
  @@index([voucherId, active, expiresAt])
  @@index([purchaseId])

  @@map("HakVoucherPelanggan")
}

model PeristiwaLinimasaPembelian {
  id         String                    @id @db.Char(36)
  purchaseId String                    @db.Char(36)
  eventType  PurchaseTimelineEventType
  reasonCode String?                   @db.VarChar(64)
  sourceKey  String                    @unique @db.VarChar(191)
  derived    Boolean                   @default(false)
  occurredAt DateTime
  createdAt  DateTime                  @default(now())
  purchase   Pembelian                  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId, occurredAt, id])

  @@map("PeristiwaLinimasaPembelian")
}

model ReservasiKodeUnikPembayaran {
  id               String         @id @db.Char(36)
  paymentAccountId String         @db.Char(36)
  purchaseId       String         @unique @db.Char(36)
  code             Int
  expiresAt        DateTime
  createdAt        DateTime       @default(now())
  paymentAccount   RekeningPembayaran @relation(fields: [paymentAccountId], references: [id], onDelete: Restrict)
  purchase         Pembelian       @relation(fields: [purchaseId], references: [id], onDelete: Restrict)

  @@unique([paymentAccountId, code])
  @@index([expiresAt])

  @@map("ReservasiKodeUnikPembayaran")
}

model PaketPelanggan {
  id                   String                @id @db.Char(36)
  purchaseId           String                @unique @db.Char(36) @map("pembelian_id")
  customerUserId       String                @db.Char(36) @map("pengguna_pelanggan_id")
  branchId             String                @db.Char(36) @map("cabang_id")
  packageId            String                @db.Char(36) @map("paket_id")
  classTypeId          String                @db.Char(36) @map("jenis_kelas_id")
  activationDate       DateTime              @db.Date @map("tanggal_aktivasi")
  expiryAt             DateTime @map("tanggal_kedaluwarsa")
  salePriceRp          Int @map("harga_jual_rp")
  sessionCountSnapshot Int @map("snapshot_jumlah_sesi")
  durationDaysSnapshot Int @map("snapshot_durasi_hari")
  projectionRateRp     Int @map("rate_proyeksi_rp")
  status               CustomerPackageStatus @default(ACTIVE) @map("status")
  version              Int                   @default(0) @map("versi")
  createdAt            DateTime              @default(now())
  purchase             Pembelian              @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  customer             User                  @relation(fields: [customerUserId], references: [id], onDelete: Restrict)
  branch               Cabang                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  package              Paket               @relation(fields: [packageId], references: [id], onDelete: Restrict)
  classType            JenisKelas             @relation(fields: [classTypeId], references: [id], onDelete: Restrict)
  ledgerEntries        EntriBukuBesar[]
  reservations         ReservasiSesi[]
  adjustments          PenyesuaianSesi[]
  bookings             PemesananKelas[]
  historical           Boolean               @default(false)
  sourceDeletedAt      DateTime?
  sourceBalance        Int?

  @@index([customerUserId, branchId, expiryAt])

  @@map("PaketPelanggan")
}
