enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model Cabang {
  id                       String                         @id @db.Char(36)
  code                     String                         @unique @map("kode")
  name                     String @map("nama")
  timezone                 String @map("zona_waktu")
  supportWhatsappE164      String?
  active                   Boolean                        @default(true) @map("aktif")
  version                  Int                            @default(0)
  createdAt                DateTime                       @default(now()) @map("dibuat_pada")
  updatedAt                DateTime                       @updatedAt @map("diperbarui_pada")
  assignments              Penugasan[]
  userRoles                UserRole[]
  configurations           KonfigurasiEfektif[]
  classTypes               JenisKelas[]
  classTypeScopes          CakupanCabangJenisKelas[]
  classTypeConfigurations  KonfigurasiJenisKelasCabang[]
  packages                 Paket[]
  packageScopes            CakupanCabangPaket[]
  paymentAccounts          RekeningPembayaran[]
  customerPackages         PaketPelanggan[]
  paymentProofs            BuktiPembayaran[]
  purchases                Pembelian[]
  vouchers                 Voucher[]
  instructorAvailabilities KetersediaanInstruktur[]
  classSlots               SlotKelas[]
  instructorHourLogs       RekapJamInstruktur[]
  bookings                 PemesananKelas[]
  reschedules              UbahJadwal[]
  customerAttendances      KehadiranPelanggan[]
  instructorAttendances    KehadiranInstruktur[]
  financeCloseSnapshots    SnapshotTutupBukuKeuangan[]
  preferredByUsers         User[]                         @relation("PreferredBranchCustomers")
  userNotifications        UserNotification[]
  publicProfile            ProfilPublikCabang?
  accessRoleAssignments    AccessRoleAssignment[]
  capabilityOverrides      UserCapabilityOverride[]
  studios                  Studio[]
  openingHours             JamOperasionalCabang[]
  recurringSchedules       JadwalRutinPelanggan[]
  accountingAccounts       AkunAkuntansi[]
  journalEntries           EntriJurnal[]
  legacyFinancialEntries   EntriKeuanganHistoris[]
  otherCosts               BiayaLain[]
  financePeriods           PeriodeKeuangan[]
  financeCorrections       KoreksiKeuangan[]
  mediaAssets              AsetMedia[]
  migrationCutover         MigrationBranchCutover?
  migrationDeltaEvents     MigrationDeltaEvent[]
  pilotRollbackOutbox      MigrationPilotOutbox[]
  pilotMediaAliases        MigrationPilotMediaAlias[]
  publicContents           EntriKontenPublik[]
  supportCases             KasusBantuan[]
  historical               Boolean                        @default(false)
  sourceDeletedAt          DateTime?

  @@map("Cabang")
}

model ProfilPublikCabang {
  branchId           String   @id @db.Char(36)
  slug               String   @unique
  area               String
  city               String
  address            String
  operationalEmail   String?
  mapUrl             String?  @db.VarChar(1024)
  latitude           Float?
  longitude          Float?
  openingHours       Json
  description        String   @db.Text
  arrivalInformation String?  @db.Text
  parkingInformation String?  @db.Text
  amenities          Json
  heroImageKey       String
  galleryImageKeys   Json
  version            Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  branch             Cabang   @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([city, area])

  @@map("ProfilPublikCabang")
}

model ProfilPublikKelas {
  code            String   @id
  slug            String   @unique
  summary         String
  description     String   @db.Text
  level           String
  durationMinutes Int
  equipment       Json
  benefits        Json
  heroImageKey    String
  active          Boolean  @default(true)
  version         Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("ProfilPublikKelas")
}

model JenisKelas {
  id                       String                         @id @db.Char(36)
  branchId                 String?                        @db.Char(36)
  code                     String                         @unique @map("kode")
  name                     String @map("nama")
  description              String?                        @db.Text
  modality                 ClassModality                  @default(UNKNOWN_LEGACY)
  equipment                Json?
  defaultDurationMinutes   Int                            @default(60)
  defaultMinimumQuota      Int                            @default(1)
  defaultCapacity          Int                            @default(1)
  active                   Boolean                        @default(true) @map("aktif")
  version                  Int                            @default(0)
  createdAt                DateTime                       @default(now()) @map("dibuat_pada")
  updatedAt                DateTime                       @updatedAt @map("diperbarui_pada")
  branch                   Cabang?                        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  branchScopes             CakupanCabangJenisKelas[]
  branchConfigurations     KonfigurasiJenisKelasCabang[]
  configurations           KonfigurasiEfektif[]
  packages                 Paket[]
  purchases                Pembelian[]
  packageScopes            CakupanJenisKelasPaket[]
  voucherScopes            Voucher[]
  customerPackages         PaketPelanggan[]
  classSlots               SlotKelas[]
  instructorHourLogs       RekapJamInstruktur[]
  recurringSchedules       JadwalRutinPelanggan[]
  customerClassEnrollments PendaftaranKelasPelanggan[]
  historical               Boolean                        @default(false)
  sourceDeletedAt          DateTime?
  sourceMetadata           Json?

  @@index([branchId, active])

  @@map("JenisKelas")
}

model CakupanCabangJenisKelas {
  id              String    @id @default(uuid()) @db.Char(36)
  classTypeId     String    @db.Char(36)
  branchId        String    @db.Char(36)
  active          Boolean   @default(true)
  historical      Boolean   @default(false)
  sourceDeletedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  classType       JenisKelas @relation(fields: [classTypeId], references: [id], onDelete: Restrict)
  branch          Cabang    @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([classTypeId, branchId])
  @@index([branchId, active])

  @@map("CakupanCabangJenisKelas")
}

model KonfigurasiJenisKelasCabang {
  id              String    @id @default(uuid()) @db.Char(36)
  classTypeId     String    @db.Char(36)
  branchId        String    @db.Char(36)
  minimumQuota    Int?
  capacity        Int?
  honorRp         Int?
  feeRp           Int?
  effectiveFrom   DateTime  @db.Date
  effectiveUntil  DateTime? @db.Date
  historical      Boolean   @default(false)
  sourceDeletedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  classType       JenisKelas @relation(fields: [classTypeId], references: [id], onDelete: Restrict)
  branch          Cabang    @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([classTypeId, branchId, effectiveFrom], map: "CTBranchConfig_type_branch_from_key")
  @@index([branchId, effectiveFrom, effectiveUntil], map: "CTBranchConfig_branch_from_until_idx")

  @@map("KonfigurasiJenisKelasCabang")
}

model KonfigurasiEfektif {
  id                 String              @id @db.Char(36)
  kind               String
  businessKey        String
  branchId           String?             @db.Char(36)
  classTypeId        String?             @db.Char(36)
  value              Json
  effectiveFrom      DateTime            @db.Date
  effectiveUntil     DateTime?           @db.Date
  version            Int                 @default(0)
  approvedEvidence   String?
  createdAt          DateTime            @default(now())
  branch             Cabang?             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  classType          JenisKelas?          @relation(fields: [classTypeId], references: [id], onDelete: Restrict)
  instructorHourLogs RekapJamInstruktur[]

  @@index([kind, businessKey, effectiveFrom, effectiveUntil])
  @@index([branchId, kind, effectiveFrom])

  @@map("KonfigurasiEfektif")
}

model Studio {
  id               String      @id @default(uuid()) @db.Char(36)
  branchId         String      @db.Char(36)
  code             String      @db.VarChar(64)
  name             String      @db.VarChar(160)
  equipmentText    String?     @db.Text
  contactPhoneE164 String?     @db.VarChar(32)
  active           Boolean     @default(true)
  historical       Boolean     @default(false)
  sourceDeletedAt  DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  branch           Cabang      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  rooms            Ruangan[]
  classSlots       SlotKelas[]

  @@unique([branchId, code])
  @@index([branchId, active])
}

model Ruangan {
  id              String      @id @default(uuid()) @db.Char(36)
  studioId        String      @db.Char(36) @map("studio_id")
  code            String      @db.VarChar(64) @map("kode")
  name            String      @db.VarChar(160) @map("nama")
  capacity        Int? @map("kapasitas")
  active          Boolean     @default(true) @map("aktif")
  historical      Boolean     @default(false)
  sourceDeletedAt DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  studio          Studio      @relation(fields: [studioId], references: [id], onDelete: Restrict)
  classSlots      SlotKelas[]

  @@unique([studioId, code])
  @@index([studioId, active])

  @@map("Ruangan")
}

model JamOperasionalCabang {
  id              String    @id @default(uuid()) @db.Char(36)
  branchId        String    @db.Char(36)
  weekday         Weekday
  opensAtMinute   Int?
  closesAtMinute  Int?
  closed          Boolean   @default(false)
  effectiveFrom   DateTime  @db.Date
  effectiveUntil  DateTime? @db.Date
  historical      Boolean   @default(false)
  sourceDeletedAt DateTime?
  branch          Cabang    @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([branchId, weekday, effectiveFrom])
  @@index([branchId, effectiveFrom, effectiveUntil])

  @@map("JamOperasionalCabang")
}
