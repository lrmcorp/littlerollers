{
  "name": "@dailydose/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start:e2e": "node --env-file=../../.env node_modules/@nestjs/cli/bin/nest.js start",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.seed.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.seed.json --noEmit",
    "pretest": "pnpm --filter @dailydose/config build && pnpm --filter @dailydose/notification-core build && pnpm --filter @dailydose/quota-evaluator build",
    "test": "jest --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "node --import ./node_modules/tsx/dist/loader.mjs prisma/seed.ts",
    "prisma:seed:minimal": "SEED_PROFILE=minimal node --import ./node_modules/tsx/dist/loader.mjs prisma/seed.ts",
    "prisma:seed:demo": "SEED_PROFILE=demo node --import ./node_modules/tsx/dist/loader.mjs prisma/seed.ts",
    "prisma:seed:volume": "SEED_PROFILE=volume node --import ./node_modules/tsx/dist/loader.mjs prisma/seed.ts"
  },
  "dependencies": {
    "@dailydose/config": "workspace:*",
    "@dailydose/notification-core": "workspace:*",
    "@dailydose/quota-evaluator": "workspace:*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@prisma/client": "^6.15.0",
    "argon2": "^0.45.1",
    "express": "^5.2.1",
    "google-auth-library": "^10.9.0",
    "ioredis": "^5.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "jest": "^30.1.3",
    "prisma": "^6.15.0",
    "ts-jest": "^29.4.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
