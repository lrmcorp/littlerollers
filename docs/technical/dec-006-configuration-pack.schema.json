{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dailydose.internal/schemas/dec-006-configuration-pack.schema.json",
  "title": "Daily Dose DEC-006 configuration pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "decisionId",
    "packId",
    "mappingVersion",
    "operational",
    "historical"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "decisionId": { "const": "DEC-006" },
    "packId": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9_.-]{2,63}$" },
    "mappingVersion": { "const": "2.0.0" },
    "operational": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectionRates", "instructorFees"],
      "properties": {
        "projectionRates": {
          "type": "array",
          "items": { "$ref": "#/$defs/projectionRate" }
        },
        "instructorFees": {
          "type": "array",
          "items": { "$ref": "#/$defs/instructorFee" }
        }
      }
    },
    "historical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectionRates", "instructorCompensations"],
      "properties": {
        "projectionRates": {
          "type": "array",
          "items": { "$ref": "#/$defs/historicalProjection" }
        },
        "instructorCompensations": {
          "type": "array",
          "items": { "$ref": "#/$defs/historicalInstructor" }
        }
      }
    }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "date": { "type": "string", "format": "date" },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceReference", "financeApproverId", "productOwnerApproverId", "approvedAt"],
      "properties": {
        "evidenceReference": { "type": "string", "minLength": 3, "maxLength": 240 },
        "financeApproverId": { "$ref": "#/$defs/uuid" },
        "productOwnerApproverId": { "$ref": "#/$defs/uuid" },
        "approvedAt": { "type": "string", "format": "date-time" }
      }
    },
    "effective": {
      "type": "object",
      "required": ["configurationId", "branchId", "classTypeId", "effectiveFrom", "approval"],
      "properties": {
        "configurationId": { "type": "string", "pattern": "^CFG-[A-Z0-9_.-]{3,60}$" },
        "branchId": { "$ref": "#/$defs/uuid" },
        "classTypeId": { "$ref": "#/$defs/uuid" },
        "effectiveFrom": { "$ref": "#/$defs/date" },
        "effectiveUntil": { "anyOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
        "approval": { "$ref": "#/$defs/approval" }
      }
    },
    "projectionRate": {
      "allOf": [
        { "$ref": "#/$defs/effective" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["configurationId", "branchId", "classTypeId", "rateRp", "effectiveFrom", "approval"],
          "properties": {
            "configurationId": true,
            "branchId": true,
            "classTypeId": true,
            "rateRp": { "type": "integer", "minimum": 0 },
            "effectiveFrom": true,
            "effectiveUntil": true,
            "approval": true
          }
        }
      ]
    },
    "instructorFee": {
      "allOf": [
        { "$ref": "#/$defs/effective" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["configurationId", "branchId", "classTypeId", "instructorUserId", "feeRp", "effectiveFrom", "approval"],
          "properties": {
            "configurationId": true,
            "branchId": true,
            "classTypeId": true,
            "instructorUserId": { "$ref": "#/$defs/uuid" },
            "feeRp": { "type": "integer", "minimum": 0 },
            "effectiveFrom": true,
            "effectiveUntil": true,
            "approval": true
          }
        }
      ]
    },
    "historicalProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourcePackageId", "sourceLocationId", "rateRp", "approval"],
      "properties": {
        "sourcePackageId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "sourceLocationId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "rateRp": { "type": "integer", "minimum": 0 },
        "approval": { "$ref": "#/$defs/approval" }
      }
    },
    "historicalInstructor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceClassId", "targetBranchId", "approval"],
      "properties": {
        "sourceClassId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "targetBranchId": { "$ref": "#/$defs/uuid" },
        "feeRp": { "type": "integer", "minimum": 0 },
        "notApplicable": { "type": "boolean" },
        "approval": { "$ref": "#/$defs/approval" }
      },
      "oneOf": [
        { "required": ["feeRp"], "not": { "required": ["notApplicable"] } },
        { "required": ["notApplicable"], "properties": { "notApplicable": { "const": true } }, "not": { "required": ["feeRp"] } }
      ]
    }
  }
}
