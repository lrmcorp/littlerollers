{
  "name": "dailydose-v2",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "bootstrap": "pnpm install && pnpm db:generate && pnpm build",
    "build": "turbo run build",
    "dev": "node --env-file=.env node_modules/turbo/bin/turbo run dev --filter=@dailydose/api --filter=@dailydose/web",
    "dev:all": "node --env-file=.env node_modules/turbo/bin/turbo run dev",
    "dev:worker": "node --env-file=.env node_modules/turbo/bin/turbo run dev --filter=@dailydose/worker",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "verify:phases": "node --env-file=.env --import ./apps/api/node_modules/tsx/dist/loader.mjs tools/verification/verify-all-phases.ts",
    "verify:spec0": "NODE_PATH=./apps/api/node_modules node --env-file=.env --import ./apps/api/node_modules/tsx/dist/loader.mjs tools/verification/verify-spec-phase0-schema.ts",
    "verify:spec1": "NODE_PATH=./apps/api/node_modules node --env-file=.env --import ./apps/api/node_modules/tsx/dist/loader.mjs tools/verification/verify-spec-phase1-operations.ts",
    "verify:spec2": "TSX_TSCONFIG_PATH=apps/api/tsconfig.json NODE_PATH=./apps/api/node_modules node --env-file=.env --import ./apps/api/node_modules/tsx/dist/loader.mjs tools/verification/verify-spec-phase2-rbac.ts",
    "verify:spec3": "TSX_TSCONFIG_PATH=apps/api/tsconfig.json NODE_PATH=./apps/api/node_modules node --env-file=.env --import ./apps/api/node_modules/tsx/dist/loader.mjs tools/verification/verify-spec-phase3-finance.ts",
    "verify:spec4": "TSX_TSCONFIG_PATH=apps/api/tsconfig.json NODE_PATH=./apps/api/node_modules node --env-file=.env --import ./apps/api/node_modules/tsx/dist/loader.mjs tools/verification/verify-spec-phase4-automation.ts",
    "verify:spec5": "ENABLE_AUTO_CANCEL=true TSX_TSCONFIG_PATH=apps/api/tsconfig.json NODE_PATH=./apps/api/node_modules node --env-file=.env --import ./apps/api/node_modules/tsx/dist/loader.mjs tools/verification/verify-spec-phase5-full-cycle.ts",
    "verify:all": "pnpm verify:phases && pnpm verify:spec0 && pnpm verify:spec1 && pnpm verify:spec2 && pnpm verify:spec3 && pnpm verify:spec4 && pnpm verify:spec5 && pnpm typecheck && pnpm --filter @dailydose/web test",
    "test:concurrency": "TSX_TSCONFIG_PATH=apps/api/tsconfig.json NODE_PATH=./apps/api/node_modules node --env-file=.env --import ./apps/api/node_modules/tsx/dist/loader.mjs tools/verification/stress-test-concurrency.ts",
    "test:adversarial:phase1": "TSX_TSCONFIG_PATH=apps/api/tsconfig.json NODE_PATH=./apps/api/node_modules node --env-file=.env --import ./apps/api/node_modules/tsx/dist/loader.mjs tools/verification/adversarial-phase1-identity-rbac.ts",
    "test:adversarial:phase2": "TSX_TSCONFIG_PATH=apps/api/tsconfig.json NODE_PATH=./apps/api/node_modules node --env-file=.env --import ./apps/api/node_modules/tsx/dist/loader.mjs tools/verification/adversarial-phase2-classes-collision.ts",
    "test:adversarial:phase3": "TSX_TSCONFIG_PATH=apps/api/tsconfig.json NODE_PATH=./apps/api/node_modules node --env-file=.env --import ./apps/api/node_modules/tsx/dist/loader.mjs tools/verification/adversarial-phase3-bookings-quota.ts",
    "test:adversarial:phase4": "TSX_TSCONFIG_PATH=apps/api/tsconfig.json NODE_PATH=./apps/api/node_modules node --env-file=.env --import ./apps/api/node_modules/tsx/dist/loader.mjs tools/verification/adversarial-phase4-checkin-sessions.ts",
    "test:adversarial:phase5": "TSX_TSCONFIG_PATH=apps/api/tsconfig.json NODE_PATH=./apps/api/node_modules node --env-file=.env --import ./apps/api/node_modules/tsx/dist/loader.mjs tools/verification/adversarial-phase5-package-adjustments.ts",
    "test:adversarial:phase6": "TSX_TSCONFIG_PATH=apps/api/tsconfig.json NODE_PATH=./apps/api/node_modules node --env-file=.env --import ./apps/api/node_modules/tsx/dist/loader.mjs tools/verification/adversarial-phase6-finance-monthly-close.ts",
    "test:uat:suites": "NODE_PATH=./apps/web/node_modules:./apps/api/node_modules node --env-file=.env --import ./apps/api/node_modules/tsx/dist/loader.mjs tools/run-browser-uat-suites.ts",
    "test:e2e:studio-journey": "NODE_PATH=./apps/web/node_modules:./apps/api/node_modules node --env-file=.env --import ./apps/api/node_modules/tsx/dist/loader.mjs tools/e2e-studio-journey.ts",
    "test:e2e:real": "pnpm --filter @dailydose/web test:e2e:real",
    "test:e2e:customer": "node --env-file=.env tools/run-customer-e2e.mjs",
    "test:e2e:customer:isolated": "node --env-file=.env tools/customer-e2e-integration.mjs",
    "test:e2e:customer:isolated:keep": "node --env-file=.env tools/customer-e2e-integration.mjs --keep",
    "test:e2e:customer:isolated:cleanup": "node --env-file=.env tools/customer-e2e-integration.mjs cleanup",
    "test:integration:api": "node --env-file=.env tools/api-integration.mjs",
    "test:integration:api:keep": "node --env-file=.env tools/api-integration.mjs --keep",
    "test:integration:api:cleanup": "node --env-file=.env tools/api-integration.mjs cleanup",
    "test:integration:harness": "node --test tools/native-mysql-harness.test.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "cd apps/api && node --env-file=../../.env node_modules/prisma/build/index.js generate --config prisma.config.ts",
    "db:migrate": "cd apps/api && node --env-file=../../.env node_modules/prisma/build/index.js migrate deploy --config prisma.config.ts",
    "db:migrate:dev": "cd apps/api && node --env-file=../../.env node_modules/prisma/build/index.js migrate dev --config prisma.config.ts",
    "db:fresh": "node --env-file=.env --import ./apps/api/node_modules/tsx/dist/loader.mjs tools/db-fresh.ts",
    "db:fresh:seed": "node --env-file=.env --import ./apps/api/node_modules/tsx/dist/loader.mjs tools/db-fresh.ts --seed",
    "migrate:fresh": "pnpm db:fresh",
    "migrate:fresh:seed": "pnpm db:fresh:seed",
    "db:seed": "node --env-file=.env --import ./apps/api/node_modules/tsx/dist/loader.mjs apps/api/prisma/seed.ts",
    "db:console": "docker exec -it dailydose-v2-mysql-1 mysql -udailydose -pb64c0a6442c3df2f4f940459955788747a844facf4be7d9e23773bad7b592308 dailydose",
    "db:seed:users": "SEED_PROFILE=users node --env-file=.env --import ./apps/api/node_modules/tsx/dist/loader.mjs apps/api/prisma/seed.ts",
    "db:seed:minimal": "SEED_PROFILE=minimal node --env-file=.env --import ./apps/api/node_modules/tsx/dist/loader.mjs apps/api/prisma/seed.ts",
    "db:seed:demo": "SEED_PROFILE=demo node --env-file=.env --import ./apps/api/node_modules/tsx/dist/loader.mjs apps/api/prisma/seed.ts",
    "db:seed:volume": "SEED_PROFILE=volume node --env-file=.env --import ./apps/api/node_modules/tsx/dist/loader.mjs apps/api/prisma/seed.ts",
    "db:seed:audit": "node --env-file=.env --import ./apps/api/node_modules/tsx/dist/loader.mjs apps/api/prisma/seed-audit.ts",
    "db:seed:cleanup": "node --env-file=.env --import ./apps/api/node_modules/tsx/dist/loader.mjs apps/api/prisma/seed-audit.ts --deactivate-residual",
    "db:packages:audit": "node --env-file=.env --import ./apps/api/node_modules/tsx/dist/loader.mjs apps/api/prisma/package-integrity.ts",
    "db:packages:repair": "node --env-file=.env --import ./apps/api/node_modules/tsx/dist/loader.mjs apps/api/prisma/package-integrity.ts --repair",
    "auth:readiness": "node --env-file=.env --import ./apps/api/node_modules/tsx/dist/loader.mjs apps/api/prisma/auth-readiness.ts",
    "db:migration:v1": "node --env-file=.env --import ./apps/api/node_modules/tsx/dist/loader.mjs apps/api/prisma/v1-migration.ts",
    "db:migration:integration": "node tools/v1-migration-integration.mjs",
    "db:migration:integration:keep": "node tools/v1-migration-integration.mjs --keep",
    "db:migration:integration:cleanup": "node tools/v1-migration-integration.mjs cleanup",
    "db:migration:rehearsal": "node tools/v1-migration-rehearsal.mjs run",
    "db:migration:rehearsal:verify": "node tools/v1-migration-rehearsal.mjs verify-evidence",
    "db:migration:rehearsal:test": "node --test tools/v1-migration-rehearsal.test.mjs",
    "finance:config:validate": "node tools/dec-006-configuration.mjs validate",
    "finance:config:compile": "node tools/dec-006-configuration.mjs compile",
    "finance:config:apply": "node tools/dec-006-configuration.mjs apply",
    "finance:config:test": "node --test tools/dec-006-configuration.test.mjs",
    "db:setup": "npm run db:generate && npm run db:migrate && npm run db:seed",
    "local:up": "docker compose -f infra/local/docker-compose.yml up -d mysql minio mailpit",
    "local:up:redis": "docker compose -f infra/local/docker-compose.yml up -d redis",
    "local:down": "docker compose -f infra/local/docker-compose.yml down"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "yaml": "^2.8.1"
  }
}
